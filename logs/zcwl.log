}

/* Display Section */
.display {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    background-color: var(--display-bg);
    border-radius: var(--radius-md);
    padding: 24px;
    overflow: hidden;
    backdrop-filter: blur(10px);
}

.history {
    font-size: 1.2rem;
    color: var(--text-secondary);
    min-height: 1.5em;
    opacity: 0.8;
    transition: all 0.3s ease;
    margin-bottom: 8px;
}

.main {
    font-size: 3.5rem;
    font-weight: 600;
    word-break: break-all;
    transition: font-size 0.1s ease;
    width: 100%;
    text-align: right;
}

/* Keypad Section */
.keypad {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.btn {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: none;
    font-size: 1.5rem;
    font-weight: 500;
    cursor: pointer;
    background-color: var(--btn-bg);
    color: var(--text-main);
    transition: all 0.15s cubic-bezier(0.2, 0.8, 0.2, 1);
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    position: relative;
    overflow: hidden;
}

.btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.1);
    transform: translate(-50%, -50%) scale(0);
    border-radius: 50%;
    transition: transform 0.2s ease-out;
}

.btn:active::after {
    transform: translate(-50%, -50%) scale(1);
    transition: 0s;
}

.btn:hover:not(:active) {
    background-color: var(--btn-hover);
    transform: translateY(-2px);
}

/* Special Types */
.btn.wide {
    grid-column: span 2;
    border-radius: var(--radius-md);
    aspect-ratio: auto;
    height: 56px;
    align-self: end;
}

.btn.operator {
    background-color: #333;
    color: var(--accent);
    font-size: 1.8rem;
}

.btn.operator.active, .btn.operator:hover {
    background-color: var(--accent);
    color: #fff;
}

.btn.action {
    background-color: #a5a5a5;
    color: #000;
}

.btn.action:hover {
    background-color: #d4d4d2;
}

.btn.equals {
    background-color: var(--accent);
    color: white;
    font-size: 2rem;
}

.btn.equals:hover {
    background-color: var(--accent-hover);
}

/* Highlight state for operators */
.btn.is-active {
    background-color: var(--text-main) !important;
    color: #000 !important;
    transform: scale(0.95);
}

/* Accessibility Focus */
.btn:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
}

/* Animations */
@keyframes pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
}

.pop-anim {
    animation: pop 0.15s ease-out;
}

/* Responsive adjustments */
@media (max-height: 750px) {
    #calc-app {
