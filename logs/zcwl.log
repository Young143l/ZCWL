}
.md3-text-field-input {
width: 100%;
padding: 12px 16px;
font-family: var(--md3-font-family);
font-size: 1rem;
color: var(--md3-sys-on-surface);
background-color: var(--md3-sys-surface);
border: 1px solid var(--md3-sys-outline);
border-radius: 4px;
outline: none;
transition: border-color var(--md3-motion-duration) var(--md3-motion-easing),
