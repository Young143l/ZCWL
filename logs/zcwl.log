  --bg-color: #f0f2f5;
  --card-bg: #ffffff;
  --text-primary: #1d1e20;
  --text-secondary: #65676b;
  --accent-color: #1877f2;
  --accent-hover: #166fe5;
  --border-color: #ddd;
  --danger-color: #e74c3c;
  --radius-sm: 8px;
