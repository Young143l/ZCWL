  --bg-color: #f4f6f8;
  --surface-color: #ffffff;
  --text-primary: #1a202c;
  --text-secondary: #4a5568;
  --primary-color: #3182ce;
  --primary-hover: #2b6cb0;
  --danger-color: #e53e3e;
  --border-radius: 12px;
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.24);
  --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
  --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-bounce: 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

/* Dark Mode Variables */
:root[data-theme="dark"] {
  --bg-color: #1a202c;
  --surface-color: #2d3748;
  --text-primary: #f7fafc;
  --text-secondary: #a0aec0;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: var(--bg-color);
  color: var(--text-primary);
  line-height: 1.6;
  transition: background-color 0.3s ease;
}

.app-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
  min-height: 100vh;
  display: grid;
  grid-template-rows: auto 1fr;
  gap: 24px;
}

/* Header & Nav */
.header {
  background: var(--surface-color);
  padding: 16px 24px;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}

#app-title {
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.025em;
}

.nav {
  display: flex;
  gap: 8px;
}

.nav-btn {
  background: transparent;
  border: none;
  padding: 8px 16px;
  border-radius: 8px;
  color: var(--text-secondary);
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.nav-btn:hover {
  background: rgba(49, 130, 206, 0.1);
  color: var(--primary-color);
}

.nav-btn.active {
  background: var(--primary-color);
  color: white;
  box-shadow: var(--shadow-md);
}

/* Main Content Area */
.main-view {
  position: relative;
  display: grid;
  grid-template-areas: "stack";
}

.view-section {
  grid-area: stack;
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
  pointer-events: none;
}

.view-section.active {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: all;
}

/* Cards & Components */
.card {
  background: var(--surface-color);
  padding: 32px;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  gap: 20px;
}

h2 {
  font-size: 1.25rem;
  color: var(--text-primary);
  margin-bottom: 8px;
}

p {
  color: var(--text-secondary);
}

/* Counter Component */
.counter-wrapper {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 12px;
}

#counter-display {
  font-size: 2rem;
  font-weight: 800;
  min-width: 60px;
  text-align: center;
  color: var(--primary-color);
}

.btn-group {
  display: flex;
  gap: 8px;
}

/* Forms */
.form-stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-secondary);
}

input, textarea {
  padding: 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: var(--bg-color);
  color: var(--text-primary);
  font-family: inherit;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

:root[data-theme="dark"] input,
:root[data-theme="dark"] textarea {
  border-color: #4a5568;
}

input:focus, textarea:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.2);
}

/* Buttons */
.action-btn {
  padding: 12px 24px;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.1s ease, box-shadow 0.2s ease, background-color 0.2s;
  align-self: flex-start;
}

.action-btn:active {
  transform: scale(0.96);
}

.primary {
  background: var(--primary-color);
  color: white;
  box-shadow: var(--shadow-sm);
}

.primary:hover {
  background: var(--primary-hover);
  box-shadow: var(--shadow-md);
}

.secondary {
  background: var(--bg-color);
  color: var(--text-primary);
  border: 1px solid #cbd5e0;
}

.secondary:hover {
  background: #e2e8f0;
}

/* Toggle & Settings */
.toggle-group {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  background: var(--bg-color);
  border-radius: 8px;
}

.toggle-btn {
  background: #cbd5e0;
  color: #2d3748;
  padding: 6px 16px;
  border-radius: 20px;
  border: none;
  font-weight: 600;
  cursor: pointer;
  transition: background-color var(--transition-fast), transform var(--transition-fast);
}

.toggle-btn[aria-pressed="true"] {
  background: var(--primary-color);
  color: white;
}

.status-area {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid rgba(0,0,0,0.05);
}

.status-text {
  font-size: 0.85rem;
  font-style: italic;
  color: var(--text-secondary);
}

/* Responsive Adjustments */
@media (max-width: 768px) {
  .header {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .nav {
    width: 100%;
    overflow-x: auto;
    padding-bottom: 4px;
  }
  
  .card {
    padding: 20px;
  }
  
  .counter-wrapper {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* Accessibility Focus Styles */
button:focus-visible,
input:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--primary-color);
  outline-offset: 2px;
}, javascript=document.addEventListener("DOMContentLoaded", () => {
  // --- State Management ---
  const state = {
    currentView: "home",
    darkMode: false,
    counter: 0,
    user: {
      username: "",
      bio: ""
    }
  };

  // --- Selectors ---
  const els = {
    body: document.body,
    navBtns: document.querySelectorAll(".nav-btn"),
    views: document.querySelectorAll(".view-section"),
    counterDisplay: document.getElementById("counter-display"),
    btnIncrement: document.getElementById("btn-increment"),
    btnDecrement: document.getElementById("btn-decrement"),
    profileForm: document.getElementById("profile-form"),
    themeToggle: document.getElementById("btn-theme-toggle"),
    statusMsg: document.getElementById("status-msg"),
    inputs: {
      username: document.getElementById("input-username"),
      bio: document.getElementById("input-bio")
    }
  };

  // --- Helpers ---
  const updateStatus = (msg) => {
    if (!els.statusMsg) return;
    els.statusMsg.textContent = msg;
    // Auto clear after 3 seconds
    setTimeout(() => {
      if (els.statusMsg.textContent === msg) {
        els.statusMsg.textContent = "Ready";
      }
    }, 3000);
  };

  const updateView = (viewName) => {
    try {
      // Update State
      state.currentView = viewName;

      // Update Nav UI
      els.navBtns.forEach((btn) => {
        if (!btn) return;
        const isActive = btn.dataset.view === viewName;
        btn.classList.toggle("active", isActive);
      });

      // Update Main View Visibility
      els.views.forEach((view) => {
        if (!view) return;
        const isTarget = view.id === `view-${viewName}`;
        view.classList.toggle("active", isTarget);
      });

      // Focus Management for Accessibility (Move focus to first heading of new view)
      const activeView = document.getElementById(`view-${viewName}`);
      if (activeView) {
        const heading = activeView.querySelector("h2");
        if (heading) {
          // Slight delay to allow transition to start
          setTimeout(() => heading.focus(), 100);
        }
      }
    } catch (error) {
      console.error("View switch error:", error);
    }
  };

  // --- Event Handlers ---

  // 1. Navigation Handler (SPA Routing)
  const handleNav = (e) => {
    e.preventDefault();
    const target = e.target.closest("button[data-view]");
    if (!target) return;
    
    const view = target.dataset.view;
    if (view === state.currentView) return;
    
    updateView(view);
  };

  // 2. Counter Logic
  const handleCounter = (e) => {
    e.preventDefault();
    const action = e.target.id === "btn-increment" ? 1 : -1;
    state.counter += action;
    
    if (els.counterDisplay) {
      els.counterDisplay.textContent = state.counter;
      
      // Micro-interaction: Color shift
      els.counterDisplay.style.color = action > 0 ? "var(--primary-color)" : "var(--danger-color)";
      setTimeout(() => {
        if (els.counterDisplay) els.counterDisplay.style.color = "";
      }, 200);
    }
  };

  // 3. Profile Form Handler
  const handleProfileSubmit = (e) => {
    e.preventDefault();
    
    try {
      const username = els.inputs.username.value.trim();
      const bio = els.inputs.bio.value.trim();

      if (!username) {
        updateStatus("Error: Username is required.");
        els.inputs.username.focus();
        return;
      }

      // Update State
      state.user.username = username;
      state.user.bio = bio;

      // Simulate API Call
      updateStatus("Saving...");
      setTimeout(() => {
