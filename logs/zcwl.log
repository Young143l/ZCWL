        filterButtons: {
            all: document.getElementById('filter-btn-all'),
            tech: document.getElementById('filter-btn-tech'),
            design: document.getElementById('filter-btn-design'),
            life: document.getElementById('filter-btn-life')
        },
        pagination: {
            prev: document.getElementById('pagination-btn-prev'),
            next: document.getElementById('pagination-btn-next'),
            info: document.getElementById('pagination-info')
        },
        articleDetailContent: document.getElementById('article-detail-content'),
        detailBackBtn: document.getElementById('detail-back-btn'),
        heroActionBtn: document.getElementById('hero-action-btn'),
        mobileMenuToggle: document.getElementById('mobile-menu-toggle'),
        mainNav: document.getElementById('main-nav'),
        navList: document.querySelector('.nav-list'),
        // createForm: document.getElementById('article-create-form'), // 保留注释
        // createSubmitBtn: document.getElementById('create-submit-btn'), // 保留注释
        // createCancelBtn: document.getElementById('create-cancel-btn'), // 保留注释
        currentYear: document.getElementById('current-year'),
        siteTitle: document.getElementById('site-title') // 新增定向修改 ID 引用
    };

    // 初始化检查
    if (!elements.appMain) {
        console.error('主应用容器未找到');
        return;
    }

    // 模拟数据源
    const mockArticles = [
        { id: 1, title: '现代 Web 开发架构演进', excerpt: '探讨从传统 MVC 到现代组件化、数据驱动架构的变化。', content: '文章详情内容：现代 Web 开发架构演进...', tag: 'technology', date: '2023-10-01', author: '架构师' },
        { id: 2, title: '极简主义设计哲学', excerpt: '如何在数字产品中实践极简主义，提升用户体验。', content: '文章详情内容：极简主义设计哲学...', tag: 'design', date: '2023-09-15', author: '设计师' },
        { id: 3, title: '保持专注的日常习惯', excerpt: '分享几种有助于在繁忙工作中保持深度专注的方法。', content: '文章详情内容：保持专注的日常习惯...', tag: 'life', date: '2023-09-01', author: '作者' },
        { id: 4, title: 'JavaScript 状态管理模式', excerpt: '在无框架环境下实现清晰、可维护的状态管理。', content: '文章详情内容：JavaScript 状态管理模式...', tag: 'technology', date: '2023-08-20', author: '开发者' },
        { id: 5, title: '色彩理论与界面设计', excerpt: '理解色彩如何影响用户情绪与产品感知。', content: '文章详情内容：色彩理论与界面设计...', tag: 'design', date: '2023-08-05', author: '设计师' },
        { id: 6, title: '远程工作高效协作指南', excerpt: '工具与流程建议，帮助团队在远程环境下高效协作。', content: '文章详情内容：远程工作高效协作指南...', tag: 'life', date: '2023-07-28', author: '团队领导' },
        { id: 7, title: 'CSS Grid 布局实战', excerpt: '使用 CSS Grid 构建复杂响应式布局的详细指南。', content: '文章详情内容：CSS Grid 布局实战...', tag: 'technology', date: '2023-07-10', author: '前端工程师' },
        { id: 8, title: '无障碍设计基础', excerpt: '确保 Web 内容对所有用户可访问的关键原则。', content: '文章详情内容：无障碍设计基础...', tag: 'design', date: '2023-06-25', author: 'UX 专家' },
        { id: 9, title: '健康的工作与生活平衡', excerpt: '在高压技术行业中维持身心健康的方法。', content: '文章详情内容：健康的工作与生活平衡...', tag: 'life', date: '2023-06-10', author: '健康顾问' }
    ];

    // 状态管理函数
    function setLoading(loading) {
        APP_STATE.isLoading = loading;
        if (elements.loadingState) {
            elements.loadingState.hidden = !loading;
        }
        // 根据加载状态禁用或启用交互元素
        const interactiveElements = [
            ...Object.values(elements.navButtons),
            elements.articlesSearchBtn,
            ...Object.values(elements.filterButtons),
            elements.pagination.prev,
            elements.pagination.next,
            elements.heroActionBtn
        ];
        interactiveElements.forEach(el => {
            if (el) el.disabled = loading;
        });
    }

    function setCurrentView(view) {
        APP_STATE.currentView = view;
        // 隐藏所有视图
        Object.values(elements.views).forEach(viewEl => {
            if (viewEl) viewEl.hidden = true;
        });
        // 显示当前视图
        const currentViewEl = elements.views[view];
        if (currentViewEl) {
            currentViewEl.hidden = false;
        }
        // 更新导航按钮状态
        Object.keys(elements.navButtons).forEach(key => {
            const btn = elements.navButtons[key];
            if (btn) {
                btn.classList.toggle('active', key === view);
            }
        });
        // 根据视图执行特定操作
        switch (view) {
            case 'home':
                renderFeaturedArticles();
                break;
            case 'articles':
                filterAndRenderArticles();
                updatePagination();
                break;
            case 'about':
                // 无额外操作
                break;
            case 'articleDetail':
                // 无额外操作
                break;
            // case 'create': // 保留注释
                // 无额外操作
                // break;
        }
    }

    function setActiveTag(tag) {
        APP_STATE.activeTag = tag;
        // 更新标签按钮状态
        Object.keys(elements.filterButtons).forEach(key => {
            const btn = elements.filterButtons[key];
            if (btn) {
                btn.classList.toggle('active', key === tag);
            }
        });
        filterAndRenderArticles();
        updatePagination();
    }

    function setSearchQuery(query) {
        APP_STATE.searchQuery = query.trim().toLowerCase();
        filterAndRenderArticles();
        updatePagination();
    }

    function setCurrentPage(page) {
        APP_STATE.currentPage = page;
        renderArticlesPage();
        updatePagination();
    }

    // 数据过滤与处理
    function filterArticles() {
        try {
            let filtered = mockArticles;
            // 按标签过滤
            if (APP_STATE.activeTag !== 'all') {
                filtered = filtered.filter(article => article.tag === APP_STATE.activeTag);
            }
            // 按搜索词过滤
            if (APP_STATE.searchQuery) {
                filtered = filtered.filter(article =>
                    article.title.toLowerCase().includes(APP_STATE.searchQuery) ||
                    article.excerpt.toLowerCase().includes(APP_STATE.searchQuery)
                );
            }
            APP_STATE.filteredArticles = filtered;
        } catch (error) {
            console.error('过滤文章时出错:', error);
            APP_STATE.filteredArticles = mockArticles;
        }
    }

    // 渲染函数
    function renderFeaturedArticles() {
        if (!elements.featuredArticlesList) return;
        const featured = mockArticles.slice(0, 3); // 取前三篇作为精选
        elements.featuredArticlesList.innerHTML = featured.map(article =>
            `<div class=\"article-card\" data-id=\"${article.id}\" role=\"button\" tabindex=\"0\" aria-label=\"阅读文章：${article.title}\">
                <h3>${article.title}</h3>
                <p class=\"excerpt\">${article.excerpt}</p>
                <div class=\"meta\">
                    <span class=\"tag\">${article.tag}</span>
                    <span>${article.date}</span>
                </div>
            </div>`
        ).join('');
        // 为精选文章卡片绑定点击事件
        elements.featuredArticlesList.querySelectorAll('.article-card').forEach(card => {
            card.addEventListener('click', handleArticleCardClick);
            card.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    handleArticleCardClick(e);
                }
            });
        });
    }

    function filterAndRenderArticles() {
        filterArticles();
        renderArticlesPage();
    }

    function renderArticlesPage() {
        if (!elements.articlesList) return;
        const startIndex = (APP_STATE.currentPage - 1) * APP_STATE.articlesPerPage;
        const endIndex = startIndex + APP_STATE.articlesPerPage;
        const articlesToShow = APP_STATE.filteredArticles.slice(startIndex, endIndex);
        elements.articlesList.innerHTML = articlesToShow.map(article =>
            `<div class=\"article-card\" data-id=\"${article.id}\" role=\"button\" tabindex=\"0\" aria-label=\"阅读文章：${article.title}\">
                <h3>${article.title}</h3>
                <p class=\"excerpt\">${article.excerpt}</n                <div class=\"meta\">
                    <span class=\"tag\">${article.tag}</span>
                    <span>${article.date}</span>
                </div>
            </div>`
        ).join('');
        // 为文章卡片绑定点击事件
        elements.articlesList.querySelectorAll('.article-card').forEach(card => {
            card.addEventListener('click', handleArticleCardClick);
            card.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    handleArticleCardClick(e);
                }
            });
        });
    }

    function renderArticleDetail(id) {
        if (!elements.articleDetailContent) return;
        const article = mockArticles.find(a => a.id === id);
        if (!article) {
            elements.articleDetailContent.innerHTML = '<p>文章未找到。</p>';
            return;
        }
        elements.articleDetailContent.innerHTML = `
            <h2>${article.title}</h2>
            <div class=\"content\">${article.content}</div>
            <div class=\"detail-meta\">
                <span class=\"tag\">${article.tag}</span>
                <span>${article.date} | 作者：${article.author}</span>
            </div>
        `;
        setCurrentView('articleDetail');
    }

    function updatePagination() {
        if (!elements.pagination.prev || !elements.pagination.next || !elements.pagination.info) return;
        const totalPages = Math.ceil(APP_STATE.filteredArticles.length / APP_STATE.articlesPerPage);
        elements.pagination.prev.disabled = APP_STATE.currentPage === 1;
        elements.pagination.next.disabled = APP_STATE.currentPage === totalPages || totalPages === 0;
        elements.pagination.info.textContent = `第 ${APP_STATE.currentPage} / ${totalPages} 页`;
    }

    // 事件处理
    function handleNavButtonClick(e) {
        e.preventDefault();
        const view = e.currentTarget.dataset.view;
        if (view && elements.views[view]) {
            setCurrentView(view);
        }
        // 移动端菜单自动关闭
        if (APP_STATE.mobileMenuOpen) {
            toggleMobileMenu(false);
        }
    }

    function handleArticleCardClick(e) {
        e.preventDefault();
        const card = e.currentTarget;
        const id = parseInt(card.dataset.id);
        if (id) {
            renderArticleDetail(id);
        }
    }

    function handleSearch(e) {
        e.preventDefault();
        if (!elements.articlesSearchInput) return;
        setSearchQuery(elements.articlesSearchInput.value);
    }

    function handleFilterClick(e) {
        e.preventDefault();
        const tag = e.currentTarget.dataset.tag;
        if (tag) {
            setActiveTag(tag);
        }
    }

    function handlePaginationClick(e, direction) {
        e.preventDefault();
        if (direction === 'prev' && APP_STATE.currentPage > 1) {
            setCurrentPage(APP_STATE.currentPage - 1);
        } else if (direction === 'next') {
            const totalPages = Math.ceil(APP_STATE.filteredArticles.length / APP_STATE.articlesPerPage);
            if (APP_STATE.currentPage < totalPages) {
                setCurrentPage(APP_STATE.currentPage + 1);
            }
        }
    }

    function handleDetailBackClick(e) {
        e.preventDefault();
        setCurrentView('articles');
    }

    function handleHeroActionClick(e) {
        e.preventDefault();
        setCurrentView('articles');
    }

    function toggleMobileMenu(open) {
        APP_STATE.mobileMenuOpen = open;
        if (elements.navList) {
            elements.navList.classList.toggle('active', open);
        }
        if (elements.mobileMenuToggle) {
            elements.mobileMenuToggle.setAttribute('aria-expanded', open);
        }
    }

    // 定向修改：根据用户需求 \"改为blog\"，优化 H1 标题元素
    function enhanceSiteTitle() {
        if (!elements.siteTitle) return;
        // 1. 添加动态标题变化效果（微交互）
        elements.siteTitle.addEventListener('mouseenter', () => {
            elements.siteTitle.style.transform = 'scale(1.05)';
            elements.siteTitle.style.transition = 'transform var(--transition-fast)';
        });
        elements.siteTitle.addEventListener('mouseleave', () => {
            elements.siteTitle.style.transform = 'scale(1)';
        });
        // 2. 添加键盘导航支持
        elements.siteTitle.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                // 可以扩展为点击标题执行特定操作，例如返回首页
                setCurrentView('home');
            }
        });
        // 3. 确保标题可聚焦（无障碍）
        elements.siteTitle.setAttribute('tabindex', '0');
        elements.siteTitle.setAttribute('role', 'button');
        elements.siteTitle.setAttribute('aria-label', '博客主页标题，点击可返回首页');
    }

    // 事件绑定
    function bindEvents() {
        // 导航按钮
        Object.values(elements.navButtons).forEach(btn => {
            if (btn) btn.addEventListener('click', handleNavButtonClick);
        });

        // 文章搜索
        if (elements.articlesSearchBtn) {
            elements.articlesSearchBtn.addEventListener('click', handleSearch);
        }
        if (elements.articlesSearchInput) {
            elements.articlesSearchInput.addEventListener('input', handleSearch);
        }

        // 标签过滤
        Object.values(elements.filterButtons).forEach(btn => {
            if (btn) btn.addEventListener('click', handleFilterClick);
        });

        // 分页
        if (elements.pagination.prev) {
            elements.pagination.prev.addEventListener('click', (e) => handlePaginationClick(e, 'prev'));
        }
        if (elements.pagination.next) {
            elements.pagination.next.addEventListener('click', (e) => handlePaginationClick(e, 'next'));
        }

        // 文章详情返回
        if (elements.detailBackBtn) {
            elements.detailBackBtn.addEventListener('click', handleDetailBackClick);
        }

        // 首页行动按钮
        if (elements.heroActionBtn) {
            elements.heroActionBtn.addEventListener('click', handleHeroActionClick);
        }

        // 移动端菜单切换
        if (elements.mobileMenuToggle) {
            elements.mobileMenuToggle.addEventListener('click', (e) => {
                e.preventDefault();
                toggleMobileMenu(!APP_STATE.mobileMenuOpen);
            });
        }

        // 定向修改调用
        enhanceSiteTitle();

        // 点击外部关闭移动菜单
        document.addEventListener('click', (e) => {
            if (APP_STATE.mobileMenuOpen && !elements.mobileMenuToggle.contains(e.target) && !elements.navList.contains(e.target)) {
                toggleMobileMenu(false);
            }
        });
    }

    // 初始化应用
    function initApp() {
        setLoading(true);
        // 模拟数据加载延迟
        setTimeout(() => {
            APP_STATE.articles = mockArticles;
            APP_STATE.filteredArticles = mockArticles;
            setLoading(false);
            setCurrentView('home');
            updatePagination();
            // 设置当前年份
            if (elements.currentYear) {
                elements.currentYear.textContent = new Date().getFullYear();
            }
        }, 500);
        bindEvents();
    }

    // 启动应用
    initApp();
});"}`
* **用户需求**：`把这个的内容改为：blog`
* **定向修改 ID**：`[H1:site-title]`

