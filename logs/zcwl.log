    // --- State Management ---
    const state = {
        view: 'home', // 'home' | 'editor'
        theme: 'light', // 'light' | 'dark'
        posts: [
            {
                id: 1698765432100,
                title: 'The Future of Vanilla JS',
                content: 'Building complex interfaces without frameworks is not only possible but often performant and educational. Modern browser APIs cover most needs.',
                date: '2023-11-01'
            },
            {
                id: 1698765432101,
                title: 'Understanding Material Design 3',
                content: 'MD3 introduces dynamic color, improved accessibility, and a more expressive design language. It emphasizes motion and hierarchy.',
                date: '2023-11-02'
            }
        ]
    };

    // --- Selectors (Strict ID System) ---
    const els = {
        body: document.body,
        views: {
            home: document.getElementById('view-home'),
            editor: document.getElementById('view-editor')
        },
        lists: {
            articles: document.getElementById('article-list')
        },
        inputs: {
            title: document.getElementById('post-title-input'),
            content: document.getElementById('post-content-input')
        },
        snackbar: document.getElementById('snackbar'),
        buttons: {
            menu: document.getElementById('menu-btn'),
            theme: document.getElementById('theme-toggle-btn'),
            create: document.getElementById('create-post-btn'),
            save: document.getElementById('save-post-btn'),
            cancel: document.getElementById('cancel-edit-btn'),
            delete: null // Dynamic
        }
    };

    // --- Helper: Show Snackbar ---
    const showSnackbar = (message) => {
        if (!els.snackbar) return;
        els.snackbar.textContent = message;
        els.snackbar.classList.add('show');
        setTimeout(() => {
            els.snackbar.classList.remove('show');
        }, 3000);
    };

    // --- Helper: View Router ---
    const switchView = (viewName) => {
        try {
            // Update State
            state.view = viewName;

            // Update DOM
            Object.keys(els.views).forEach(key => {
                if (els.views[key]) {
                    els.views[key].classList.remove('active');
                }
            });

            if (els.views[viewName]) {
                els.views[viewName].classList.add('active');
            }

            // Cleanup inputs on switch to editor
            if (viewName === 'editor') {
                els.inputs.title.value = '';
                els.inputs.content.value = '';
                els.inputs.title.focus();
            }
        } catch (error) {
            console.error('Error switching view:', error);
        }
    };

    // --- Logic: Theme Toggle ---
    const toggleTheme = () => {
        if (!els.body) return;
        
        const isDark = els.body.classList.toggle('dark-mode');
        state.theme = isDark ? 'dark' : 'light';
        
        // Update Icon (Simple text swap for vanilla implementation)
        if (els.buttons.theme) {
            els.buttons.theme.innerHTML = isDark ? '&#9790;' : '&#9728;';
        }
    };

    // --- Logic: Render List ---
    const renderList = () => {
        if (!els.lists.articles) return;
        els.lists.articles.innerHTML = '';

        if (state.posts.length === 0) {
            els.lists.articles.innerHTML = '<p style=\"text-align:center; color:var(--md3-on-surface-variant); padding:20px;\">No posts yet. Create one!</p>';
            return;
        }

        state.posts.forEach(post => {
            const card = document.createElement('div');
            card.className = 'article-card';
            card.id = `post-${post.id}`;
            
            // Content Wrapper
            const contentWrapper = document.createElement('div');
            contentWrapper.className = 'article-card-content';
            
            const title = document.createElement('h3');
            title.textContent = post.title;
            
            const preview = document.createElement('p');
            preview.textContent = post.content;
            
            const meta = document.createElement('div');
            meta.className = 'article-meta';
            meta.textContent = post.date;
            
            contentWrapper.appendChild(title);
            contentWrapper.appendChild(preview);
            contentWrapper.appendChild(meta);
            
            // Delete Button
            const delBtn = document.createElement('button');
            delBtn.className = 'delete-btn';
            delBtn.innerHTML = '&times;';
            delBtn.setAttribute('aria-label', 'Delete Post');
            delBtn.dataset.id = post.id;
            
            // Event: Delete
            delBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                e.preventDefault();
                handleDelete(post.id);
            });

            // Event: Click Card (Could expand view)
            card.addEventListener('click', (e) => {
                if (e.target !== delBtn) {
                    showSnackbar(`Selected: ${post.title}`);
                }
            });

            card.appendChild(contentWrapper);
            card.appendChild(delBtn);
            els.lists.articles.appendChild(card);
        });
    };

    // --- Logic: Handle Save ---
    const handleSave = () => {
        const title = els.inputs.title.value.trim();
        const content = els.inputs.content.value.trim();

        if (!title || !content) {
            showSnackbar('Please fill in all fields');
            return;
        }

        const newPost = {
            id: Date.now(),
            title: title,
            content: content,
            date: new Date().toISOString().split('T')[0]
        };

        // Unshift to beginning of array
        state.posts.unshift(newPost);
        
        renderList();
        switchView('home');
        showSnackbar('Post published successfully');
    };

    // --- Logic: Handle Delete ---
    const handleDelete = (id) => {
        // Confirmation (Simple native confirm)
        if (confirm('Are you sure you want to delete this post?')) {
            state.posts = state.posts.filter(p => p.id !== id);
            
            // Animation removal
            const card = document.getElementById(`post-${id}`);
            if (card) {
                card.style.opacity = '0';
                card.style.transform = 'translateX(20px)';
                setTimeout(() => {
                    renderList();
                    showSnackbar('Post deleted');
                }, 200);
            } else {
                renderList();
                showSnackbar('Post deleted');
            }
        }
    };

    // --- Event Binding ---
    const bindEvents = () => {
        // Theme Toggle
        if (els.buttons.theme) {
            els.buttons.theme.addEventListener('click', (e) => {
                e.preventDefault();
                toggleTheme();
            });
        }

        // Menu (Mock)
        if (els.buttons.menu) {
            els.buttons.menu.addEventListener('click', (e) => {
                e.preventDefault();
                showSnackbar('Menu opened (Mock)');
            });
        }

        // Create New Post -> Navigate to Editor
        if (els.buttons.create) {
            els.buttons.create.addEventListener('click', (e) => {
                e.preventDefault();
                switchView('editor');
            });
        }

        // Cancel Edit -> Navigate to Home
        if (els.buttons.cancel) {
            els.buttons.cancel.addEventListener('click', (e) => {
                e.preventDefault();
                switchView('home');
            });
        }

        // Save Post
        if (els.buttons.save) {
            els.buttons.save.addEventListener('click', (e) => {
                e.preventDefault();
                handleSave();
            });
        }
    };

    // --- Initialization ---
    const init = () => {
        // Strict Existence Checks
        if (!els.body || !els.snackbar) {
            console.error('Critical DOM elements missing');
            return;
        }

        bindEvents();
        renderList();
        
        console.log('MD3 Blog App Initialized');
    };

    // Run
    init();
});"}`
