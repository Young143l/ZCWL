    --bg-color: #1c1c1e;
    --calc-bg: #000000;
    --display-bg: #1c1c1e;
    --btn-bg: #2c2c2e;
    --btn-hover: #3a3a3c;
    --accent: #ff9f0a;
    --accent-hover: #ffb03b;
    --text-main: #ffffff;
    --text-secondary: #8e8e93;
    --radius-lg: 24px;
    --radius-md: 12px;
    --radius-sm: 8px;
    --shadow-elevation: 0 20px 40px rgba(0, 0, 0, 0.4);
    --font-main: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
}

body {
    background-color: var(--bg-color);
    color: var(--text-main);
    font-family: var(--font-main);
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

#calc-app {
    width: 100%;
    max-width: 400px;
    height: 100%;
    max-height: 900px;
    background-color: var(--calc-bg);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: var(--shadow-elevation);
    padding: 20px;
    gap: 20px;
}

/* Display Section */
.display {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    background-color: var(--display-bg);
    border-radius: var(--radius-md);
    padding: 24px;
    overflow: hidden;
    backdrop-filter: blur(10px);
}

.history {
    font-size: 1.2rem;
    color: var(--text-secondary);
    min-height: 1.5em;
    opacity: 0.8;
    transition: all 0.3s ease;
    margin-bottom: 8px;
}

.main {
    font-size: 3.5rem;
    font-weight: 600;
    word-break: break-all;
    transition: font-size 0.1s ease;
    width: 100%;
    text-align: right;
}

/* Keypad Section */
.keypad {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.btn {
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: none;
    font-size: 1.5rem;
    font-weight: 500;
    cursor: pointer;
    background-color: var(--btn-bg);
    color: var(--text-main);
    transition: all 0.15s cubic-bezier(0.2, 0.8, 0.2, 1);
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    position: relative;
    overflow: hidden;
}

.btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.1);
    transform: translate(-50%, -50%) scale(0);
    border-radius: 50%;
    transition: transform 0.2s ease-out;
}

.btn:active::after {
    transform: translate(-50%, -50%) scale(1);
    transition: 0s;
}

.btn:hover:not(:active) {
    background-color: var(--btn-hover);
    transform: translateY(-2px);
}

/* Special Types */
.btn.wide {
    grid-column: span 2;
    border-radius: var(--radius-md);
    aspect-ratio: auto;
    height: 56px;
    align-self: end;
}

.btn.operator {
    background-color: #333;
    color: var(--accent);
    font-size: 1.8rem;
}

.btn.operator.active, .btn.operator:hover {
    background-color: var(--accent);
    color: #fff;
}

.btn.action {
    background-color: #a5a5a5;
    color: #000;
}

.btn.action:hover {
    background-color: #d4d4d2;
}

.btn.equals {
    background-color: var(--accent);
    color: white;
    font-size: 2rem;
}

.btn.equals:hover {
    background-color: var(--accent-hover);
}

/* Highlight state for operators */
.btn.is-active {
    background-color: var(--text-main) !important;
    color: #000 !important;
    transform: scale(0.95);
}

/* Accessibility Focus */
.btn:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
}

/* Animations */
@keyframes pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
}

.pop-anim {
    animation: pop 0.15s ease-out;
}

/* Responsive adjustments */
@media (max-height: 750px) {
    #calc-app {
        padding: 10px;
        gap: 10px;
    }
    .main {
        font-size: 2.5rem;
    }
    .btn {
        font-size: 1.2rem;
    }
}

/* Mobile specific adjustments */
@media (max-width: 420px) {
    body {
        background-color: #000;
    }
    #calc-app {
        max-width: 100%;
        max-height: 100%;
        border-radius: 0;
        gap: 10px;
        padding: 10px;
    }
    .btn {
        border-radius: 16px;
    }
    .keypad {
        gap: 8px;
    }
