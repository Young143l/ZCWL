--md3-sys-primary: #6750A4;
--md3-sys-on-primary: #FFFFFF;
--md3-sys-primary-container: #EADDFF;
--md3-sys-on-primary-container: #21005D;
--md3-sys-secondary: #625B71;
--md3-sys-on-secondary: #FFFFFF;
--md3-sys-secondary-container: #E8DEF8;
--md3-sys-on-secondary-container: #1D192B;
--md3-sys-tertiary: #7D5260;
--md3-sys-on-tertiary: #FFFFFF;
--md3-sys-tertiary-container: #FFD8E4;
--md3-sys-on-tertiary-container: #31111D;
--md3-sys-background: #FFFBFE;
--md3-sys-on-background: #1C1B1F;
--md3-sys-surface: #FFFBFE;
--md3-sys-on-surface: #1C1B1F;
--md3-sys-surface-variant: #E7E0EC;
--md3-sys-on-surface-variant: #49454F;
--md3-sys-outline: #79747E;
--md3-sys-outline-variant: #CAC4D0;
--md3-sys-error: #B3261E;
--md3-sys-on-error: #FFFFFF;
--md3-sys-surface-tint: #6750A4;
--md3-elevation-1: 0px 1px 2px rgba(0, 0, 0, 0.3), 0px 1px 3px 1px rgba(0, 0, 0, 0.15);
--md3-elevation-2: 0px 1px 2px rgba(0, 0, 0, 0.3), 0px 2px 6px 2px rgba(0, 0, 0, 0.15);
--md3-elevation-3: 0px 4px 8px 3px rgba(0, 0, 0, 0.15), 0px 1px 3px rgba(0, 0, 0, 0.3);
--md3-font-family: \"Roboto\", sans-serif;
--md3-motion-easing: cubic-bezier(0.2, 0, 0, 1);
--md3-motion-duration: 200ms;
}
*, *::before, *::after {
box-sizing: border-box;
margin: 0;
padding: 0;
}
html {
scroll-behavior: smooth;
}
body {
font-family: var(--md3-font-family);
background-color: var(--md3-sys-background);
color: var(--md3-sys-on-background);
line-height: 1.5;
-webkit-font-smoothing: antialiased;
-moz-osx-font-smoothing: grayscale;
}
#app-container {
min-height: 100vh;
display: flex;
flex-direction: column;
}
.md3-header {
position: sticky;
top: 0;
z-index: 100;
background-color: var(--md3-sys-surface);
border-bottom: 1px solid var(--md3-sys-outline-variant);
box-shadow: var(--md3-elevation-1);
}
.header-content {
max-width: 800px;
margin: 0 auto;
padding: 16px;
display: flex;
align-items: center;
justify-content: space-between;
flex-wrap: wrap;
gap: 12px;
}
#app-title {
font-size: 1.5rem;
font-weight: 500;
color: var(--md3-sys-primary);
}
.md3-nav {
display: flex;
gap: 8px;
}
.md3-nav-btn {
font-family: var(--md3-font-family);
font-size: 0.875rem;
font-weight: 500;
padding: 10px 24px;
border: none;
border-radius: 20px;
background: transparent;
color: var(--md3-sys-on-surface);
cursor: pointer;
transition: background-color var(--md3-motion-duration) var(--md3-motion-easing), 
color var(--md3-motion-duration) var(--md3-motion-easing),
box-shadow var(--md3-motion-duration) var(--md3-motion-easing);
}
.md3-nav-btn:hover {
background-color: var(--md3-sys-surface-variant);
}
.md3-nav-btn:focus-visible {
outline: 2px solid var(--md3-sys-primary);
outline-offset: 2px;
}
.md3-nav-btn-active {
background-color: var(--md3-sys-secondary-container);
color: var(--md3-sys-on-secondary-container);
}
.md3-main {
flex: 1;
max-width: 800px;
width: 100%;
margin: 0 auto;
padding: 24px 16px;
}
.md3-view {
display: none;
}
.md3-view-active {
display: block;
animation: fadeIn var(--md3-motion-duration) var(--md3-motion-easing);
}
@keyframes fadeIn {
from { opacity: 0; transform: translateY(8px); }
to { opacity: 1; transform: translateY(0); }
}
.md3-post-list {
display: flex;
flex-direction: column;
gap: 16px;
}
.md3-post-card {
background-color: var(--md3-sys-surface);
border: 1px solid var(--md3-sys-outline-variant);
border-radius: 12px;
padding: 20px;
cursor: pointer;
transition: box-shadow var(--md3-motion-duration) var(--md3-motion-easing), 
border-color var(--md3-motion-duration) var(--md3-motion-easing),
transform var(--md3-motion-duration) var(--md3-motion-easing);
}
.md3-post-card:hover {
box-shadow: var(--md3-elevation-2);
border-color: var(--md3-sys-primary);
}
.md3-post-card:focus-visible {
outline: 2px solid var(--md3-sys-primary);
outline-offset: 2px;
}
.md3-post-card:active {
transform: scale(0.98);
}
.md3-post-card-title {
font-size: 1.25rem;
font-weight: 500;
color: var(--md3-sys-on-surface);
margin-bottom: 8px;
}
.md3-post-card-excerpt {
font-size: 0.875rem;
color: var(--md3-sys-on-surface-variant);
margin-bottom: 12px;
}
.md3-post-card-meta {
font-size: 0.75rem;
color: var(--md3-sys-outline);
display: flex;
gap: 16px;
}
.md3-post-detail {
background-color: var(--md3-sys-surface);
border-radius: 12px;
padding: 24px;
box-shadow: var(--md3-elevation-1);
}
.md3-post-detail-title {
font-size: 1.75rem;
font-weight: 500;
color: var(--md3-sys-on-surface);
margin-bottom: 16px;
}
.md3-post-detail-meta {
font-size: 0.875rem;
color: var(--md3-sys-outline);
margin-bottom: 24px;
padding-bottom: 16px;
border-bottom: 1px solid var(--md3-sys-outline-variant);
}
.md3-post-detail-content {
font-size: 1rem;
color: var(--md3-sys-on-surface);
line-height: 1.7;
white-space: pre-wrap;
}
.md3-fab {
position: fixed;
bottom: 24px;
left: 24px;
z-index: 50;
width: 56px;
height: 56px;
border-radius: 16px;
border: none;
background-color: var(--md3-sys-secondary-container);
color: var(--md3-sys-on-secondary-container);
cursor: pointer;
box-shadow: var(--md3-elevation-3);
display: flex;
align-items: center;
justify-content: center;
transition: box-shadow var(--md3-motion-duration) var(--md3-motion-easing),
background-color var(--md3-motion-duration) var(--md3-motion-easing);
}
.md3-fab:hover {
box-shadow: var(--md3-elevation-2);
}
.md3-fab:focus-visible {
outline: 2px solid var(--md3-sys-primary);
outline-offset: 2px;
}
.md3-fab:active {
background-color: var(--md3-sys-surface-variant);
}
.md3-fab-mini {
width: 40px;
height: 40px;
border-radius: 12px;
}
.md3-form {
background-color: var(--md3-sys-surface);
border: 1px solid var(--md3-sys-outline-variant);
border-radius: 12px;
padding: 24px;
}
.md3-form-title {
font-size: 1.5rem;
font-weight: 500;
color: var(--md3-sys-on-surface);
margin-bottom: 24px;
}
.md3-text-field {
margin-bottom: 20px;
}
.md3-text-field-label {
display: block;
font-size: 0.75rem;
font-weight: 500;
color: var(--md3-sys-on-surface-variant);
margin-bottom: 8px;
}
.md3-text-field-input {
width: 100%;
padding: 12px 16px;
font-family: var(--md3-font-family);
font-size: 1rem;
color: var(--md3-sys-on-surface);
background-color: var(--md3-sys-surface);
border: 1px solid var(--md3-sys-outline);
border-radius: 4px;
outline: none;
transition: border-color var(--md3-motion-duration) var(--md3-motion-easing),
box-shadow var(--md3-motion-duration) var(--md3-motion-easing);
}
.md3-text-field-input:focus {
border-color: var(--md3-sys-primary);
box-shadow: 0 0 0 2px var(--md3-sys-primary-container);
}
.md3-text-field-input::placeholder {
color: var(--md3-sys-outline);
}
.md3-text-field-input:invalid:not(:placeholder-shown) {
border-color: var(--md3-sys-error);
}
.md3-text-field-area .md3-text-field-input {
resize: vertical;
min-height: 120px;
}
.md3-btn {
font-family: var(--md3-font-family);
font-size: 0.875rem;
font-weight: 500;
letter-spacing: 0.1px;
padding: 10px 24px;
border: none;
border-radius: 20px;
cursor: pointer;
transition: box-shadow var(--md3-motion-duration) var(--md3-motion-easing),
background-color var(--md3-motion-duration) var(--md3-motion-easing);
}
.md3-btn-filled {
background-color: var(--md3-sys-primary);
color: var(--md3-sys-on-primary);
}
.md3-btn-filled:hover {
box-shadow: var(--md3-elevation-1);
}
.md3-btn-filled:active {
background-color: var(--md3-sys-surface-tint);
}
.md3-btn-filled:focus-visible {
outline: 2px solid var(--md3-sys-primary);
outline-offset: 2px;
}
.md3-footer {
background-color: var(--md3-sys-surface);
border-top: 1px solid var(--md3-sys-outline-variant);
padding: 16px;
text-align: center;
}
.md3-footer p {
font-size: 0.75rem;
color: var(--md3-sys-outline);
}
.empty-state {
text-align: center;
padding: 48px 24px;
color: var(--md3-sys-on-surface-variant);
}
.sr-only {
position: absolute;
width: 1px;
height: 1px;
padding: 0;
margin: -1px;
overflow: hidden;
clip: rect(0, 0, 0, 0);
white-space: nowrap;
border: 0;
}
@media (max-width: 600px) {
.header-content {
flex-direction: column;
align-items: flex-start;
}
.md3-nav {
width: 100%;
justify-content: flex-start;
}
.md3-post-card {
padding: 16px;
}
.md3-post-detail {
padding: 16px;
}
.md3-post-detail-title {
font-size: 1.5rem;
}
.md3-form {
padding: 16px;
}
.md3-fab {
bottom: 16px;
left: 16px;
}
}", javascript: "document.addEventListener(\"DOMContentLoaded\", function() {
var appContainer = document.getElementById(\"app-container\");
if (!appContainer) {
console.error(\"App container not found\");
return;
}

var state = {
currentView: \"home\",
posts: [
{
id: 1,
title: \"Getting Started with Material Design 3\",
content: \"Material Design 3 (MD3) is the latest version of Google's design system. It introduces dynamic color, more expressive components, and a more personalized experience.\\n\\nKey features include:\\n- Dynamic color schemes based on user wallpaper\\n- Updated component shapes (more rounded)\\n- Improved accessibility\\n- Better support for dark mode\\n\\nThis blog demonstrates a clean implementation of MD3 principles using vanilla JavaScript and CSS.\",
excerpt: \"Learn the fundamentals of MD3 and how to implement it in your web projects.\",
author: \"Design Team\",
date: \"2024-01-15\"
},
{
id: 2,
title: \"Building Modern Web Apps with Vanilla JS\",
content: \"In an era dominated by frameworks, building with vanilla JavaScript remains a valuable skill. Modern ES6+ features make it easier than ever to create performant, maintainable applications.\\n\\nBenefits of vanilla JS:\\n- No build step required\\n- Smaller bundle sizes\\n- Better understanding of web fundamentals\\n- Easier debugging\\n\\nThis application showcases how to create a smooth SPA experience without any external frameworks.\",
excerpt: \"Discover why vanilla JS is still a powerful choice for modern web development.\",
author: \"Dev Team\",
date: \"2024-01-10\"
},
{
id: 3,
title: \"CSS Architecture for Scalable Applications\",
content: \"Good CSS architecture is crucial for maintainable web applications. Using CSS custom properties, modern layout techniques, and a component-based approach can significantly improve your codebase.\\n\\nBest practices:\\n- Use CSS variables for theming\\n- Embrace Flexbox and Grid\\n- Implement mobile-first responsive design\\n- Keep selectors simple and specific\\n\\nThis blog uses these principles to create a consistent, scalable design system.\",
excerpt: \"Learn how to structure your CSS for long-term maintainability.\",
author: \"CSS Masters\",
date: \"2024-01-05\"
}
],
selectedPostId: null
};

var views = {
home: document.getElementById(\"view-home\"),
detail: document.getElementById(\"view-detail\"),
create: document.getElementById(\"view-create\")
};

var navHomeBtn = document.getElementById(\"nav-home\");
var navCreateBtn = document.getElementById(\"nav-create\");
var postListContainer = document.getElementById(\"post-list\");
var postDetailContainer = document.getElementById(\"post-detail\");
var backBtn = document.getElementById(\"back-btn\");
var createForm = document.getElementById(\"create-post-form\");

function escapeHtml(text) {
if (text === null || text === undefined) {
return \"\";
}
var div = document.createElement(\"div\");
div.textContent = String(text);
return div.innerHTML;
}

function formatDate(dateStr) {
try {
var date = new Date(dateStr);
if (isNaN(date.getTime())) {
return dateStr;
}
return date.toLocaleDateString(\"en-US\", {
year: \"numeric\",
month: \"long\",
day: \"numeric\"
});
} catch (e) {
return dateStr;
}
}

function renderPostList() {
if (!postListContainer) {
console.error(\"Post list container not found\");
return;
}

postListContainer.setAttribute(\"aria-busy\", \"true\");

if (state.posts.length === 0) {
postListContainer.innerHTML = '<div class=\"empty-state\"><p>No posts yet. Create your first post!</p></div>';
postListContainer.setAttribute(\"aria-busy\", \"false\");
return;
}

var postsHtml = state.posts.map(function(post) {
return '<article class=\"md3-post-card\" data-post-id=\"' + post.id + '\" tabindex=\"0\" role=\"button\" aria-label=\"Read ' + escapeHtml(post.title) + '\">' +
'<h2 class=\"md3-post-card-title\">' + escapeHtml(post.title) + '</h2>' +
'<p class=\"md3-post-card-excerpt\">' + escapeHtml(post.excerpt) + '</p>' +
'<div class=\"md3-post-card-meta\">' +
'<span>By ' + escapeHtml(post.author) + '</span>' +
'<span>' + formatDate(post.date) + '</span>' +
'</div>' +
'</article>';
}).join(\"\");

postListContainer.innerHTML = postsHtml;
postListContainer.setAttribute(\"aria-busy\", \"false\");

var cards = postListContainer.querySelectorAll(\".md3-post-card\");
cards.forEach(function(card) {
card.addEventListener(\"click\", handlePostCardClick);
card.addEventListener(\"keydown\", handlePostCardKeydown);
});
}

function handlePostCardClick(e) {
e.preventDefault();
var postId = parseInt(this.dataset.postId, 10);
if (!isNaN(postId)) {
showPostDetail(postId);
}
}

function handlePostCardKeydown(e) {
if (e.key === \"Enter\" || e.key === \" \") {
e.preventDefault();
e.stopPropagation();
var postId = parseInt(this.dataset.postId, 10);
if (!isNaN(postId)) {
showPostDetail(postId);
}
}
}

function renderPostDetail(postId) {
if (!postDetailContainer) {
console.error(\"Post detail container not found\");
return;
}

var post = null;
for (var i = 0; i < state.posts.length; i++) {
if (state.posts[i].id === postId) {
post = state.posts[i];
break;
}
}

if (!post) {
postDetailContainer.innerHTML = '<div class=\"empty-state\"><p>Post not found.</p></div>';
return;
}

postDetailContainer.innerHTML = '<h1 class=\"md3-post-detail-title\">' + escapeHtml(post.title) + '</h1>' +
'<div class=\"md3-post-detail-meta\">' +
'<span>By ' + escapeHtml(post.author) + '</span>' +
'<span>' + formatDate(post.date) + '</span>' +
'</div>' +
'<div class=\"md3-post-detail-content\">' + escapeHtml(post.content) + '</div>';
}

function showView(viewName) {
if (!views.home || !views.detail || !views.create) {
console.error(\"One or more views not found\");
return;
}

Object.keys(views).forEach(function(key) {
views[key].classList.remove(\"md3-view-active\");
views[key].setAttribute(\"aria-hidden\", \"true\");
});

var targetView = views[viewName];
if (targetView) {
targetView.classList.add(\"md3-view-active\");
targetView.setAttribute(\"aria-hidden\", \"false\");
}

if (navHomeBtn && navCreateBtn) {
navHomeBtn.classList.remove(\"md3-nav-btn-active\");
navCreateBtn.classList.remove(\"md3-nav-btn-active\");
navHomeBtn.setAttribute(\"aria-pressed\", \"false\");
navCreateBtn.setAttribute(\"aria-pressed\", \"false\");

if (viewName === \"home\") {
navHomeBtn.classList.add(\"md3-nav-btn-active\");
navHomeBtn.setAttribute(\"aria-pressed\", \"true\");
} else if (viewName === \"create\") {
navCreateBtn.classList.add(\"md3-nav-btn-active\");
navCreateBtn.setAttribute(\"aria-pressed\", \"true\");
}
}

state.currentView = viewName;

if (viewName === \"home\") {
window.scrollTo({ top: 0, behavior: \"smooth\" });
}
}

function showPostDetail(postId) {
if (!postId || isNaN(postId)) {
console.error(\"Invalid post ID\");
return;
}

state.selectedPostId = postId;
renderPostDetail(postId);
showView(\"detail\");
}

function showHome() {
state.selectedPostId = null;
renderPostList();
showView(\"home\");
}

function showCreate() {
state.selectedPostId = null;
if (createForm) {
createForm.reset();
}
showView(\"create\");
}

function handleNavButtonClick(e) {
var btn = e.currentTarget;
var viewName = btn.dataset.view;

if (!viewName) {
return;
}

if (viewName === \"home\") {
showHome();
} else if (viewName === \"create\") {
showCreate();
}
}

function handleBackButtonClick(e) {
e.preventDefault();
showHome();
}

function handleFormSubmit(e) {
e.preventDefault();

var titleInput = document.getElementById(\"post-title-input\");
var excerptInput = document.getElementById(\"post-excerpt-input\");
var contentInput = document.getElementById(\"post-content-input\");
var authorInput = document.getElementById(\"post-author-input\");

if (!titleInput || !excerptInput || !contentInput || !authorInput) {
console.error(\"Form inputs not found\");
return;
}

var title = titleInput.value.trim();
var excerpt = excerptInput.value.trim();
var content = contentInput.value.trim();
var author = authorInput.value.trim();

if (!title || !excerpt || !content || !author) {
console.warn(\"All fields are required\");
return;
}

try {
var newPost = {
id: Date.now(),
title: title,
excerpt: excerpt,
content: content,
author: author,
date: new Date().toISOString().split(\"T\")[0]
};

state.posts.unshift(newPost);

showHome();
} catch (error) {
console.error(\"Error creating post:\", error);
}
}

if (navHomeBtn) {
navHomeBtn.addEventListener(\"click\", handleNavButtonClick);
}

if (navCreateBtn) {
navCreateBtn.addEventListener(\"click\", handleNavButtonClick);
}

if (backBtn) {
backBtn.addEventListener(\"click\", handleBackButtonClick);
}

if (createForm) {
createForm.addEventListener(\"submit\", handleFormSubmit);
}

renderPostList();
showView(\"home\");

console.log(\"MD3 Blog initialized successfully\");
});"}`
