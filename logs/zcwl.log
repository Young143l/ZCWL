/**
 * Modern Calculator Application
 * Architecture: Vanilla JS ES6+ Class-based State Management
 * Features: Keyboard support, error handling, precision handling
 */

class Calculator {
  constructor(previousOperandElement, currentOperandElement) {
    if (!previousOperandElement || !currentOperandElement) {
      throw new Error('Calculator requires valid DOM elements');
    }
    this.previousOperandElement = previousOperandElement;
    this.currentOperandElement = currentOperandElement;
    this.reset();
  }

  reset() {
    this.currentOperand = '0';
    this.previousOperand = '';
    this.operation = undefined;
    this.shouldResetScreen = false;
    this.removeErrorState();
  }

  clear() {
    this.reset();
    this.updateDisplay();
  }

  delete() {
    if (this.shouldResetScreen) return;
    if (this.currentOperand === '0') return;
    if (this.currentOperand.length === 1) {
      this.currentOperand = '0';
    } else {
      this.currentOperand = this.currentOperand.slice(0, -1);
    }
    this.updateDisplay();
  }

  appendNumber(number) {
    if (this.shouldResetScreen) {
      this.currentOperand = '';
      this.shouldResetScreen = false;
    }
    if (number === '.' && this.currentOperand.includes('.')) return;
    if (this.currentOperand === '0' && number !== '.') {
      this.currentOperand = number.toString();
    } else {
      this.currentOperand += number.toString();
    }
    this.updateDisplay();
  }

  chooseOperation(operation) {
    if (this.currentOperand === '') return;
    if (this.previousOperand !== '') {
      this.compute();
    }
    this.operation = operation;
    this.previousOperand = this.currentOperand;
    this.currentOperand = '';
    this.updateDisplay();
  }

  compute() {
    let computation;
    const prev = parseFloat(this.previousOperand);
    const current = parseFloat(this.currentOperand);
    if (isNaN(prev) || isNaN(current)) return;

    try {
      switch (this.operation) {
        case '+':
          computation = prev + current;
          break;
        case '−':
        case '-':
          computation = prev - current;
          break;
        case '×':
        case '*':
          computation = prev * current;
          break;
        case '÷':
        case '/':
          if (current === 0) {
            this.showError('Cannot divide by zero');
            return;
          }
          computation = prev / current;
          break;
        default:
          return;
      }

      // Handle precision issues
      computation = Math.round(computation * 100000000) / 100000000;
      
      this.currentOperand = computation.toString();
      this.operation = undefined;
      this.previousOperand = '';
      this.shouldResetScreen = true;
      this.updateDisplay();
    } catch (error) {
      this.showError('Error');
      console.error('Calculation error:', error);
    }
  }

  percent() {
    const current = parseFloat(this.currentOperand);
    if (isNaN(current)) return;
    this.currentOperand = (current / 100).toString();
    this.updateDisplay();
  }

  getDisplayNumber(number) {
    if (number === 'Error') return number;
    const stringNumber = number.toString();
    const integerDigits = parseFloat(stringNumber.split('.')[0]);
    const decimalDigits = stringNumber.split('.')[1];
    let integerDisplay;
    if (isNaN(integerDigits)) {
      integerDisplay = '';
    } else {
      integerDisplay = integerDigits.toLocaleString('en', { maximumFractionDigits: 0 });
    }
    if (decimalDigits != null) {
      return `${integerDisplay}.${decimalDigits}`;
    } else {
      return integerDisplay;
    }
  }

  updateDisplay() {
    if (!this.currentOperandElement || !this.previousOperandElement) return;
    
    this.currentOperandElement.innerText = this.getDisplayNumber(this.currentOperand);
    
    if (this.operation != null) {
      this.previousOperandElement.innerText = `${this.getDisplayNumber(this.previousOperand)} ${this.operation}`;
    } else {
      this.previousOperandElement.innerText = '';
    }
  }

  showError(message) {
    this.currentOperand = message;
    this.previousOperand = '';
    this.operation = undefined;
    this.updateDisplay();
    this.currentOperandElement.classList.add('error');
    this.shouldResetScreen = true;
  }

  removeErrorState() {
    if (this.currentOperandElement) {
      this.currentOperandElement.classList.remove('error');
    }
  }
}

// Application Initialization
document.addEventListener('DOMContentLoaded', () => {
  try {
    const previousOperandElement = document.getElementById('calc-previous-operand');
    const currentOperandElement = document.getElementById('calc-current-operand');
    
    if (!previousOperandElement || !currentOperandElement) {
      console.error('Calculator display elements not found');
      return;
    }

    const calculator = new Calculator(previousOperandElement, currentOperandElement);

    // Button Event Listeners
    const numberButtons = document.querySelectorAll('[data-number]');
    const operationButtons = document.querySelectorAll('[data-operation]');
    const equalsButton = document.getElementById('btn-equals');
    const clearButton = document.getElementById('btn-clear');
    const deleteButton = document.getElementById('btn-delete');
    const percentButton = document.getElementById('btn-percent');

    numberButtons.forEach(button => {
      if (!button) return;
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const number = button.getAttribute('data-number');
        if (number) calculator.appendNumber(number);
      });
    });

    operationButtons.forEach(button => {
      if (!button) return;
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const operation = button.getAttribute('data-operation');
        if (operation) calculator.chooseOperation(operation);
      });
    });

    if (equalsButton) {
      equalsButton.addEventListener('click', (e) => {
        e.preventDefault();
        calculator.compute();
      });
    }

    if (clearButton) {
      clearButton.addEventListener('click', (e) => {
        e.preventDefault();
        calculator.clear();
      });
    }

    if (deleteButton) {
      deleteButton.addEventListener('click', (e) => {
        e.preventDefault();
        calculator.delete();
      });
    }

    if (percentButton) {
      percentButton.addEventListener('click', (e) => {
        e.preventDefault();
        calculator.percent();
      });
    }

    // Keyboard Support
    document.addEventListener('keydown', (e) => {
      try {
        let key = e.key;
        
        // Prevent default for calculator keys
        if (/^[0-9.\/*\-+=EnterEscapeBackspace]$/.test(key) || key === 'Enter') {
          e.preventDefault();
        }

        // Number keys
        if (key >= '0' && key <= '9') {
          calculator.appendNumber(key);
          highlightButton(`btn-${key}`);
        }
        
        // Decimal
        if (key === '.') {
          calculator.appendNumber('.');
          highlightButton('btn-dot');
        }
        
        // Operations
        if (key === '+' || key === 'Add') {
          calculator.chooseOperation('+');
          highlightButton('btn-add');
        }
        if (key === '-' || key === 'Subtract') {
          calculator.chooseOperation('−');
          highlightButton('btn-subtract');
        }
        if (key === '*' || key === 'x' || key === 'X' || key === 'Multiply') {
          calculator.chooseOperation('×');
          highlightButton('btn-multiply');
        }
        if (key === '/' || key === 'Divide') {
          calculator.chooseOperation('÷');
          highlightButton('btn-divide');
        }
        
        // Enter/Equals
        if (key === 'Enter' || key === '=') {
          calculator.compute();
          highlightButton('btn-equals');
        }
        
        // Escape/Clear
        if (key === 'Escape' || key === 'c' || key === 'C') {
          calculator.clear();
          highlightButton('btn-clear');
        }
        
        // Backspace/Delete
        if (key === 'Backspace') {
          calculator.delete();
          highlightButton('btn-delete');
        }
        
        // Percent
        if (key === '%') {
          calculator.percent();
          highlightButton('btn-percent');
        }
      } catch (error) {
        console.error('Keyboard handling error:', error);
      }
    });

    // Helper function to highlight button on keyboard press
    function highlightButton(buttonId) {
      const button = document.getElementById(buttonId);
      if (button) {
        button.classList.add('active');
        button.style.transform = 'scale(0.95)';
        button.style.background = 'var(--bg-tertiary)';
        setTimeout(() => {
          button.classList.remove('active');
          button.style.transform = '';
          button.style.background = '';
        }, 100);
      }
    }

    // Initialize display
    calculator.updateDisplay();
    
    console.log('Calculator initialized successfully');
  } catch (error) {
    console.error('Calculator initialization error:', error);
  }
});
