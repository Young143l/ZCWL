align-items: center;
justify-content: space-between;
flex-wrap: wrap;
gap: 12px;
}
#app-title {
font-size: 1.5rem;
font-weight: 500;
color: var(--md3-sys-primary);
}
.md3-nav {
display: flex;
gap: 8px;
}
.md3-nav-btn {
font-family: var(--md3-font-family);
