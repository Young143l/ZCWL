</head>
<body>
    <header id="main-header" role="banner" aria-label="主标题">
        <div class="container header-container">
            <h1 id="site-title">简约博客</h1>
            <nav id="main-nav" role="navigation" aria-label="主导航">
                <ul class="nav-list">
                    <li><button id="nav-btn-home" class="nav-btn active" data-view="home">首页</button></li>
                    <li><button id="nav-btn-articles" class="nav-btn" data-view="articles">文章</button></li>
                    <li><button id="nav-btn-about" class="nav-btn" data-view="about">关于</button></li>
                </ul>
            </nav>
            <button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="切换移动端菜单" aria-expanded="false"><i class="fas fa-bars"></i></button>
        </div>
    </header>

    <main id="app-main" role="main" aria-label="主要内容区域">
        <div id="loading-state" class="loading-state" aria-live="polite" aria-busy="true">
            <div class="loader"></div>
            <p>正在加载...</p>
        </div>

        <!-- Home View -->
        <section id="view-home" class="view" aria-label="首页视图" hidden>
            <div class="container">
                <div class="hero-section">
                    <h2 id="hero-title">记录思考，分享见解</h2>
                    <p id="hero-description">这是一个专注于内容与设计的简约博客平台。</p>
                    <button id="hero-action-btn" class="btn-primary" data-action="explore-articles">探索文章</button>
                </div>
                <div class="featured-section">
                    <h3>精选文章</h3>
                    <div id="featured-articles-list" class="articles-grid"></div>
                </div>
            </div>
        </section>

        <!-- Articles View -->
        <section id="view-articles" class="view" aria-label="文章列表视图" hidden>
            <div class="container">
                <h2>所有文章</h2>
                <div class="articles-controls">
                    <div class="search-box">
                        <input id="articles-search-input" type="search" placeholder="搜索文章标题或内容..." aria-label="搜索文章">
                        <button id="articles-search-btn" class="btn-icon" aria-label="执行搜索"><i class="fas fa-search"></i></button>
                    </div>
                    <div class="filter-tags">
                        <button id="filter-btn-all" class="tag-btn active" data-tag="all">全部</button>
                        <button id="filter-btn-tech" class="tag-btn" data-tag="technology">技术</button>
                        <button id="filter-btn-design" class="tag-btn" data-tag="design">设计</button>
                        <button id="filter-btn-life" class="tag-btn" data-tag="life">生活</button>
                    </div>
                </div>
                <div id="articles-list" class="articles-grid"></div>
                <div id="articles-pagination" class="pagination" aria-label="文章分页">
                    <button id="pagination-btn-prev" class="pagination-btn" disabled aria-label="上一页"><i class="fas fa-chevron-left"></i></button>
                    <span id="pagination-info" class="pagination-info">第 1 / 1 页</span>
                    <button id="pagination-btn-next" class="pagination-btn" disabled aria-label="下一页"><i class="fas fa-chevron-right"></i></button>
                </div>
            </div>
        </section>

        <!-- Article Detail View -->
        <section id="view-article-detail" class="view" aria-label="文章详情视图" hidden>
            <div class="container">
                <button id="detail-back-btn" class="btn-icon back-btn" aria-label="返回文章列表"><i class="fas fa-arrow-left"></i> 返回</button>
                <article id="article-detail-content" class="article-detail" role="article"></article>
            </div>
        </section>

        <!-- About View -->
        <section id="view-about" class="view" aria-label="关于视图" hidden>
            <div class="container">
                <h2>关于这个博客</h2>
                <div class="about-content">
                    <p>这是一个使用现代 Web 标准构建的简约博客演示项目。</p>
                    <p>它展示了无框架环境下，通过原生 JavaScript 实现数据驱动视图、状态管理及流畅的单页应用体验。</p>
                    <p>关注细节，注重无障碍访问与响应式设计。</p>
                </div>
                <div class="contact-info">
                    <h3>联系</h3>
                    <ul>
                        <li><i class="fas fa-envelope"></i> <span>example@blog.demo</span></li>
                        <li><i class="fab fa-github"></i> <span>GitHub: demo-blog</span></li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Create Article View (Optional) -->
        <section id="view-create" class="view" aria-label="创建文章视图" hidden>
            <div class="container">
                <h2>创建新文章</h2>
                <form id="article-create-form" class="create-form" aria-label="创建文章表单">
                    <div class="form-group">
                        <label for="create-title-input">标题</label>
                        <input id="create-title-input" type="text" required aria-required="true" placeholder="请输入文章标题">
                    </div>
                    <div class="form-group">
                        <label for="create-content-input">内容</label>
                        <textarea id="create-content-input" rows="10" required aria-required="true" placeholder="请输入文章内容"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="create-tag-select">标签</label>
                        <select id="create-tag-select" aria-label="选择文章标签">
                            <option value="technology">技术</option>
                            <option value="design">设计</option>
                            <option value="life">生活</option>
                        </select>
                    </div>
                    <div class="form-actions">
                        <button id="create-submit-btn" type="submit" class="btn-primary" aria-label="提交文章">发布文章</button>
                        <button id="create-cancel-btn" type="button" class="btn-secondary" aria-label="取消创建">取消</button>
                    </div>
                </form>
            </div>
        </section>
    </main>

    <footer id="main-footer" role="contentinfo" aria-label="页脚">
        <div class="container footer-container">
