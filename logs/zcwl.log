    // 数据过滤与处理
    function filterArticles() {
        try {
            let filtered = mockArticles;
            // 按标签过滤
            if (APP_STATE.activeTag !== 'all') {
                filtered = filtered.filter(article => article.tag === APP_STATE.activeTag);
            }
            // 按搜索词过滤
            if (APP_STATE.searchQuery) {
                filtered = filtered.filter(article =>
                    article.title.toLowerCase().includes(APP_STATE.searchQuery) ||
                    article.excerpt.toLowerCase().includes(APP_STATE.searchQuery)
                );
            }
            APP_STATE.filteredArticles = filtered;
        } catch (error) {
            console.error('过滤文章时出错:', error);
