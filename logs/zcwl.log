            <p>遵循 <a href="https://www.w3.org/WAI/" target="_blank" rel="noopener" aria-label="访问 WAI 无障碍指南（外部链接）">WAI 无障碍指南</a> 构建。</p>
        </div>
    </footer>
</body>
</html>, javascript=document.addEventListener('DOMContentLoaded', () => {
    // 应用状态
    const APP_STATE = {
        currentView: 'home',
        articles: [],
