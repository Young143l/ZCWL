  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* Header */
#app-header {
  background: var(--card-bg);
  border-bottom: 1px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}

.header-inner {
  max-width: 680px;
  margin: 0 auto;
  padding: 1rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

#page-title {
  font-size: 1.25rem;
  font-weight: 700;
}

#toggle-compose-btn {
  background: var(--accent-color);
  color: white;
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 1.5rem;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--transition-speed);
}

#toggle-compose-btn:hover {
  background: var(--accent-hover);
}

/* Feed List */
.feed-list {
  max-width: 680px;
  margin: 1.5rem auto;
  padding: 0 1rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* Post Card */
.post-card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 1.25rem;
  box-shadow: var(--shadow-sm);
  animation: fadeInUp 0.4s var(--easing);
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.post-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #a8c0ff, #3f2b96);
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.avatar::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.2);
}

.post-meta {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-weight: 600;
  font-size: 0.95rem;
}

.post-time {
  font-size: 0.75rem;
  color: var(--text-secondary);
}

.post-content {
  font-size: 1rem;
  color: #333;
  white-space: pre-wrap;
  word-break: break-word;
}

.post-actions {
  border-top: 1px solid #eee;
  padding-top: 0.75rem;
  display: flex;
  gap: 1rem;
}

.action-btn {
  background: transparent;
  border: none;
  color: var(--text-secondary);
  font-size: 0.9rem;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  transition: all var(--transition-speed);
  display: flex;
  align-items: center;
  gap: 4px;
}

.action-btn:hover {
  background: #f0f2f5;
  color: var(--accent-color);
}

/* Compose Modal */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-speed);
}

.overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.compose-card {
  background: var(--card-bg);
  width: 90%;
  max-width: 500px;
  border-radius: var(--radius-md);
  padding: 1.5rem;
  transform: scale(0.95);
  transition: transform var(--transition-speed) var(--easing);
  box-shadow: var(--shadow-md);
}

.overlay.active .compose-card {
  transform: scale(1);
}

.compose-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.compose-header h2 {
  font-size: 1.1rem;
}

#close-compose-btn {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: var(--text-secondary);
  line-height: 1;
}

#compose-input {
  width: 100%;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 0.75rem;
  font-family: var(--font-family);
  font-size: 1rem;
  resize: vertical;
  min-height: 100px;
  transition: border-color var(--transition-speed);
}

#compose-input:focus {
  outline: none;
  border-color: var(--accent-color);
  box-shadow: 0 0 0 2px rgba(24, 119, 242, 0.1);
}

.compose-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
  margin-top: 1rem;
}

.compose-actions button {
  padding: 0.5rem 1rem;
  border-radius: var(--radius-sm);
  border: none;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--transition-speed);
}

#cancel-compose-btn {
  background: #e4e6eb;
  color: #333;
}

#cancel-compose-btn:hover {
  background: #d8dadf;
}

#submit-post-btn {
  background: var(--accent-color);
  color: white;
}

#submit-post-btn:hover {
  background: var(--accent-hover);
}

#submit-post-btn:disabled {
  background: #9ebcf5;
  cursor: not-allowed;
}

/* Toast */
.toast {
  position: fixed;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 0.75rem 1.5rem;
  border-radius: 2rem;
  font-size: 0.9rem;
  z-index: 300;
  opacity: 0;
  transition: all 0.3s var(--easing);
  pointer-events: none;
}

.toast.visible {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.hidden {
  display: none !important;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--text-secondary);
}

.empty-state p {
  margin-top: 0.5rem;
  font-size: 0.9rem;
}

/* Mobile adjustments */
@media (max-width: 480px) {
  .feed-list {
    padding: 0 0.5rem;
    gap: 0.75rem;
  }
  .post-card {
    padding: 1rem;
  }
}, javascript=document.addEventListener("DOMContentLoaded", () => {
  // --- State Management ---
  const store = {
    posts: [],
    isComposing: false,
  };

  // --- DOM Elements ---
  const els = {
    root: document.getElementById("app-root"),
    feed: document.getElementById("feed-container"),
    composeOverlay: document.getElementById("compose-overlay"),
    toggleComposeBtn: document.getElementById("toggle-compose-btn"),
    closeComposeBtn: document.getElementById("close-compose-btn"),
    cancelComposeBtn: document.getElementById("cancel-compose-btn"),
    composeForm: document.getElementById("compose-form"),
    composeInput: document.getElementById("compose-input"),
    submitBtn: document.getElementById("submit-post-btn"),
    toast: document.getElementById("toast-notification"),
  };

  // --- Mock Data Seeding ---
  const seedData = [
    {
      id: 1,
      author: "Alex Chen",
      content: "今天天气真不错，适合去公园散步。阳光透过树叶的感觉太棒了！",
      timestamp: "2小时前",
    },
    {
      id: 2,
      author: "Sarah Wang",
      content: "刚完成了一个复杂的前端架构重构，Vanilla JS + CSS Variables 真香！🚀",
      timestamp: "5小时前",
    },
  ];

  // --- Core Functions ---

  /**
   * 渲染动态列表
   * Data-driven view approach
   */
  function renderFeed() {
    if (!els.feed) return;

    els.feed.innerHTML = ""; // Clear current list

    if (store.posts.length === 0) {
      els.feed.innerHTML = `
        <div class="empty-state">
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">📭</div>
          <p>暂无动态</p>
          <p>点击右下角按钮发布第一条评论吧！</p>
        </div>
      `;
      return;
    }

    try {
      const fragment = document.createDocumentFragment();

      store.posts.forEach(post => {
        const article = document.createElement("article");
        article.className = "post-card";
        article.id = `post-${post.id}`;
        article.setAttribute("role", "article");
        
        // Template literal for structure
        article.innerHTML = `
          <div class="post-header">
            <div class="avatar" aria-hidden="true"></div>
            <div class="post-meta">
              <span class="author-name">${escapeHtml(post.author)}</span>
              <span class="post-time">${escapeHtml(post.timestamp)}</span>
            </div>
          </div>
          <div class="post-content">${escapeHtml(post.content)}</div>
          <div class="post-actions">
            <button class="action-btn like-btn" aria-label="点赞">
              <span>👍</span> <span>赞</span>
            </button>
            <button class="action-btn comment-btn" aria-label="评论">
              <span>💬</span> <span>评论</span>
            </button>
          </div>
        `;
        fragment.appendChild(article);
      });

      els.feed.appendChild(fragment);
    } catch (error) {
      console.error("Render Error:", error);
    }
  }

  /**
   * 显示 Toast 提示
   */
  function showToast(message) {
    if (!els.toast) return;
    els.toast.textContent = message;
    els.toast.classList.add("visible");
    
    setTimeout(() => {
      els.toast.classList.remove("visible");
    }, 2500);
  }

  /**
   * 切换发布窗口状态
   */
  function toggleComposeModal(show) {
    if (!els.composeOverlay) return;
    
    store.isComposing = show;
    
    if (show) {
      els.composeOverlay.classList.remove("hidden");
      // Force reflow to trigger transition
      void els.composeOverlay.offsetWidth;
      els.composeOverlay.classList.add("active");
      
      // Focus input for better UX
      setTimeout(() => els.composeInput?.focus(), 100);
    } else {
      els.composeOverlay.classList.remove("active");
      setTimeout(() => {
        els.composeOverlay.classList.add("hidden");
        els.composeInput.value = ""; // Clear input
      }, 200);
    }
  }

  /**
   * 处理发布逻辑
   */
  function handlePostSubmission(e) {
    e.preventDefault();
    
    const content = els.composeInput.value.trim();
    if (!content) {
      showToast("内容不能为空哦");
      return;
    }

    // Optimistic UI Update
    const newPost = {
      id: Date.now(),
      author: "我",
      content: content,
      timestamp: "刚刚",
    };

    // Add to store (Unshift to show newest first)
    store.posts.unshift(newPost);
    
    // Update UI
    renderFeed();
    
    // Close Modal & Feedback
    toggleComposeModal(false);
    showToast("发布成功！");
  }

  /**
   * 安全的 HTML 转义，防止 XSS
   */
  function escapeHtml(text) {
    if (!text) return "";
    return text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  // --- Event Listeners ---

  // 1. Toggle Compose Modal
  els.toggleComposeBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    toggleComposeModal(true);
  });

  // 2. Close Modal Buttons
  [els.closeComposeBtn, els.cancelComposeBtn].forEach(btn => {
    btn?.addEventListener("click", (e) => {
      e.preventDefault();
      toggleComposeModal(false);
    });
  });

  // 3. Click Overlay to Close
  els.composeOverlay?.addEventListener("click", (e) => {
    if (e.target === els.composeOverlay) {
      toggleComposeModal(false);
    }
  });

  // 4. Form Submission
  els.composeForm?.addEventListener("submit", handlePostSubmission);

  // 5. Keyboard Support (Escape key to close modal)
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && store.isComposing) {
      toggleComposeModal(false);
    }
  });

  // 6. Delegate Action Clicks (Like/Comment) for performance
  els.feed?.addEventListener("click", (e) => {
    const btn = e.target.closest(".action-btn");
    if (!btn) return;
    
    if (btn.classList.contains("like-btn")) {
      // Simple visual toggle for demo
      const span = btn.querySelector("span:last-child");
      if (span) {
        span.textContent = span.textContent === "赞" ? "已赞" : "赞";
        btn.style.color = btn.style.color ? "" : "var(--accent-color)";
      }
    } else if (btn.classList.contains("comment-btn")) {
      showToast("评论功能暂未开放");
    }
  });

  // --- Initialization ---
  function init() {
    // Load initial data
    store.posts = [...seedData];
    renderFeed();
  }

  // Run init
  init();
});, html=<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>极简朋友圈</title>
</head>
<body id="app-root">
  <!-- Header -->
  <header id="app-header">
    <div class="header-inner">
      <h1 id="page-title">朋友圈</h1>
      <button id="toggle-compose-btn" aria-label="发布动态">+</button>
    </div>
  </header>

  <!-- Compose Area (Modal/Overlay) -->
  <div id="compose-overlay" class="overlay hidden">
    <div class="compose-card">
      <div class="compose-header">
        <h2>发动态</h2>
