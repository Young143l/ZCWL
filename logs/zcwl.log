}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-family);
  background-color: var(--bg-color);
  color: var(--text-primary);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* Header */
#app-header {
  background: var(--card-bg);
  border-bottom: 1px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}

.header-inner {
  max-width: 680px;
  margin: 0 auto;
  padding: 1rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

#page-title {
  font-size: 1.25rem;
  font-weight: 700;
}

#toggle-compose-btn {
  background: var(--accent-color);
  color: white;
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 1.5rem;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--transition-speed);
}

#toggle-compose-btn:hover {
  background: var(--accent-hover);
}

/* Feed List */
.feed-list {
  max-width: 680px;
  margin: 1.5rem auto;
  padding: 0 1rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* Post Card */
.post-card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 1.25rem;
  box-shadow: var(--shadow-sm);
  animation: fadeInUp 0.4s var(--easing);
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.post-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #a8c0ff, #3f2b96);
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.avatar::after {
  content: \"\";
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.2);
}

.post-meta {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-weight: 600;
  font-size: 0.95rem;
}

.post-time {
  font-size: 0.75rem;
  color: var(--text-secondary);
}

.post-content {
  font-size: 1rem;
  color: #333;
  white-space: pre-wrap;
  word-break: break-word;
}

.post-actions {
  border-top: 1px solid #eee;
  padding-top: 0.75rem;
  display: flex;
  gap: 1rem;
}

.action-btn {
  background: transparent;
  border: none;
  color: var(--text-secondary);
  font-size: 0.9rem;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  transition: all var(--transition-speed);
  display: flex;
  align-items: center;
  gap: 4px;
}

.action-btn:hover {
  background: #f0f2f5;
  color: var(--accent-color);
}

/* Compose Modal */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-speed);
}

.overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.compose-card {
  background: var(--card-bg);
  width: 90%;
  max-width: 500px;
  border-radius: var(--radius-md);
  padding: 1.5rem;
  transform: scale(0.95);
  transition: transform var(--transition-speed) var(--easing);
  box-shadow: var(--shadow-md);
}

.overlay.active .compose-card {
  transform: scale(1);
}

.compose-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.compose-header h2 {
  font-size: 1.1rem;
}

#close-compose-btn {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: var(--text-secondary);
  line-height: 1;
}

#compose-input {
  width: 100%;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 0.75rem;
  font-family: var(--font-family);
  font-size: 1rem;
  resize: vertical;
  min-height: 100px;
  transition: border-color var(--transition-speed);
}

#compose-input:focus {
  outline: none;
  border-color: var(--accent-color);
  box-shadow: 0 0 0 2px rgba(24, 119, 242, 0.1);
}

.compose-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
  margin-top: 1rem;
}

.compose-actions button {
  padding: 0.5rem 1rem;
  border-radius: var(--radius-sm);
  border: none;
  font-weight: 600;
  cursor: pointer;
  transition: background var(--transition-speed);
}

#cancel-compose-btn {
  background: #e4e6eb;
  color: #333;
}

#cancel-compose-btn:hover {
  background: #d8dadf;
}

#submit-post-btn {
  background: var(--accent-color);
  color: white;
}

#submit-post-btn:hover {
  background: var(--accent-hover);
}

#submit-post-btn:disabled {
  background: #9ebcf5;
  cursor: not-allowed;
}

/* Toast */
.toast {
  position: fixed;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 0.75rem 1.5rem;
  border-radius: 2rem;
  font-size: 0.9rem;
  z-index: 300;
  opacity: 0;
  transition: all 0.3s var(--easing);
  pointer-events: none;
}

.toast.visible {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.hidden {
  display: none !important;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--text-secondary);
}

.empty-state p {
  margin-top: 0.5rem;
  font-size: 0.9rem;
}

/* Mobile adjustments */
@media (max-width: 480px) {
  .feed-list {
    padding: 0 0.5rem;
    gap: 0.75rem;
  }
  .post-card {
    padding: 1rem;
  }
