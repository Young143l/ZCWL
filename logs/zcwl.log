  // --- State Management ---
  const store = {
    posts: [],
    isComposing: false,
  };

  // --- DOM Elements ---
  const els = {
    root: document.getElementById(\"app-root\"),
    feed: document.getElementById(\"feed-container\"),
    composeOverlay: document.getElementById(\"compose-overlay\"),
    toggleComposeBtn: document.getElementById(\"toggle-compose-btn\"),
    closeComposeBtn: document.getElementById(\"close-compose-btn\"),
    cancelComposeBtn: document.getElementById(\"cancel-compose-btn\"),
    composeForm: document.getElementById(\"compose-form\"),
    composeInput: document.getElementById(\"compose-input\"),
    submitBtn: document.getElementById(\"submit-post-btn\"),
    toast: document.getElementById(\"toast-notification\"),
  };

  // --- Mock Data Seeding ---
  const seedData = [
    {
      id: 1,
      author: \"Alex Chen\",
      content: \"今天天气真不错，适合去公园散步。阳光透过树叶的感觉太棒了！\",
      timestamp: \"2小时前\",
    },
    {
      id: 2,
      author: \"Sarah Wang\",
      content: \"刚完成了一个复杂的前端架构重构，Vanilla JS + CSS Variables 真香！🚀\",
      timestamp: \"5小时前\",
    },
  ];

  // --- Core Functions ---

  /**
   * 渲染动态列表
   * Data-driven view approach
   */
  function renderFeed() {
    if (!els.feed) return;

    els.feed.innerHTML = \"\"; // Clear current list

    if (store.posts.length === 0) {
      els.feed.innerHTML = `
        <div class=\"empty-state\">
          <div style=\"font-size: 2rem; margin-bottom: 0.5rem;\">📭</div>
          <p>暂无动态</p>
          <p>点击右下角按钮发布第一条评论吧！</p>
        </div>
      `;
      return;
    }

    try {
      const fragment = document.createDocumentFragment();

      store.posts.forEach(post => {
        const article = document.createElement(\"article\");
        article.className = \"post-card\";
        article.id = `post-${post.id}`;
        article.setAttribute(\"role\", \"article\");
        
        // Template literal for structure
        article.innerHTML = `
          <div class=\"post-header\">
            <div class=\"avatar\" aria-hidden=\"true\"></div>
            <div class=\"post-meta\">
              <span class=\"author-name\">${escapeHtml(post.author)}</span>
              <span class=\"post-time\">${escapeHtml(post.timestamp)}</span>
            </div>
          </div>
          <div class=\"post-content\">${escapeHtml(post.content)}</div>
          <div class=\"post-actions\">
            <button class=\"action-btn like-btn\" aria-label=\"点赞\">
              <span>👍</span> <span>赞</span>
            </button>
            <button class=\"action-btn comment-btn\" aria-label=\"评论\">
              <span>💬</span> <span>评论</span>
            </button>
          </div>
        `;
        fragment.appendChild(article);
      });

      els.feed.appendChild(fragment);
    } catch (error) {
      console.error(\"Render Error:\", error);
    }
  }

  /**
   * 显示 Toast 提示
   */
  function showToast(message) {
    if (!els.toast) return;
    els.toast.textContent = message;
    els.toast.classList.add(\"visible\");
    
    setTimeout(() => {
      els.toast.classList.remove(\"visible\");
    }, 2500);
  }

  /**
   * 切换发布窗口状态
   */
  function toggleComposeModal(show) {
    if (!els.composeOverlay) return;
    
    store.isComposing = show;
    
    if (show) {
      els.composeOverlay.classList.remove(\"hidden\");
      // Force reflow to trigger transition
      void els.composeOverlay.offsetWidth;
      els.composeOverlay.classList.add(\"active\");
      
      // Focus input for better UX
      setTimeout(() => els.composeInput?.focus(), 100);
    } else {
      els.composeOverlay.classList.remove(\"active\");
      setTimeout(() => {
        els.composeOverlay.classList.add(\"hidden\");
        els.composeInput.value = \"\"; // Clear input
      }, 200);
    }
  }

  /**
   * 处理发布逻辑
   */
  function handlePostSubmission(e) {
    e.preventDefault();
    
    const content = els.composeInput.value.trim();
    if (!content) {
      showToast(\"内容不能为空哦\");
      return;
    }

    // Optimistic UI Update
    const newPost = {
      id: Date.now(),
      author: \"我\",
      content: content,
      timestamp: \"刚刚\",
    };

    // Add to store (Unshift to show newest first)
    store.posts.unshift(newPost);
    
    // Update UI
    renderFeed();
    
    // Close Modal & Feedback
    toggleComposeModal(false);
    showToast(\"发布成功！\");
  }

  /**
   * 安全的 HTML 转义，防止 XSS
   */
  function escapeHtml(text) {
    if (!text) return \"\";
    return text
      .replace(/&/g, \"&amp;\")
      .replace(/</g, \"&lt;\")
      .replace(/>/g, \"&gt;\")
      .replace(/\"/g, \"&quot;\")
      .replace(/'/g, \"&#039;\");
  }

  // --- Event Listeners ---

  // 1. Toggle Compose Modal
  els.toggleComposeBtn?.addEventListener(\"click\", (e) => {
    e.preventDefault();
    toggleComposeModal(true);
  });

  // 2. Close Modal Buttons
  [els.closeComposeBtn, els.cancelComposeBtn].forEach(btn => {
    btn?.addEventListener(\"click\", (e) => {
      e.preventDefault();
      toggleComposeModal(false);
    });
  });

  // 3. Click Overlay to Close
  els.composeOverlay?.addEventListener(\"click\", (e) => {
    if (e.target === els.composeOverlay) {
      toggleComposeModal(false);
    }
  });

  // 4. Form Submission
  els.composeForm?.addEventListener(\"submit\", handlePostSubmission);

  // 5. Keyboard Support (Escape key to close modal)
  document.addEventListener(\"keydown\", (e) => {
    if (e.key === \"Escape\" && store.isComposing) {
      toggleComposeModal(false);
    }
  });

  // 6. Delegate Action Clicks (Like/Comment) for performance
  els.feed?.addEventListener(\"click\", (e) => {
    const btn = e.target.closest(\".action-btn\");
    if (!btn) return;
    
    if (btn.classList.contains(\"like-btn\")) {
      // Simple visual toggle for demo
      const span = btn.querySelector(\"span:last-child\");
      if (span) {
        span.textContent = span.textContent === \"赞\" ? \"已赞\" : \"赞\";
        btn.style.color = btn.style.color ? \"\" : \"var(--accent-color)\";
      }
    } else if (btn.classList.contains(\"comment-btn\")) {
      showToast(\"评论功能暂未开放\");
    }
  });

  // --- Initialization ---
  function init() {
    // Load initial data
    store.posts = [...seedData];
    renderFeed();
  }

  // Run init
  init();
});"}`
