}, javascript=document.addEventListener("DOMContentLoaded", () => {
const app = document.getElementById('app-container');
if (!app) return;

const state = {
currentView: 'home',
posts: [
{
id: 1,
title: 'Getting Started with Material Design 3',
content: 'Material Design 3 (MD3) is the latest version of Google\'s design system. It introduces dynamic color, more expressive components, and a more personalized experience.\n\nKey features include:\n- Dynamic color schemes based on user wallpaper\n- Updated component shapes (more rounded)\n- Improved accessibility\n- Better support for dark mode\n\nThis blog demonstrates a clean implementation of MD3 principles using vanilla JavaScript and CSS.',
excerpt: 'Learn the fundamentals of MD3 and how to implement it in your web projects.',
author: 'Design Team',
date: '2024-01-15'
},
{
id: 2,
title: 'Building Modern Web Apps with Vanilla JS',
content: 'In an era dominated by frameworks, building with vanilla JavaScript remains a valuable skill. Modern ES6+ features make it easier than ever to create performant, maintainable applications.\n\nBenefits of vanilla JS:\n- No build step required\n- Smaller bundle sizes\n- Better understanding of web fundamentals\n- Easier debugging\n\nThis application showcases how to create a smooth SPA experience without any external frameworks.',
excerpt: 'Discover why vanilla JS is still a powerful choice for modern web development.',
author: 'Dev Team',
date: '2024-01-10'
},
{
id: 3,
title: 'CSS Architecture for Scalable Applications',
content: 'Good CSS architecture is crucial for maintainable web applications. Using CSS custom properties, modern layout techniques, and a component-based approach can significantly improve your codebase.\n\nBest practices:\n- Use CSS variables for theming\n- Embrace Flexbox and Grid\n- Implement mobile-first responsive design\n- Keep selectors simple and specific\n\nThis blog uses these principles to create a consistent, scalable design system.',
excerpt: 'Learn how to structure your CSS for long-term maintainability.',
author: 'CSS Masters',
date: '2024-01-05'
}
],
selectedPostId: null
};

const views = {
home: document.getElementById('view-home'),
detail: document.getElementById('view-detail'),
create: document.getElementById('view-create')
};

const navButtons = document.querySelectorAll('.md3-nav-btn');
const postList = document.getElementById('post-list');
const postDetail = document.getElementById('post-detail');
const backBtn = document.getElementById('back-btn');
const createForm = document.getElementById('create-post-form');

function escapeHtml(text) {
const div = document.createElement('div');
div.textContent = text;
return div.innerHTML;
}

function formatDate(dateStr) {
const date = new Date(dateStr);
return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function renderPostList() {
if (!postList) return;

if (state.posts.length === 0) {
postList.innerHTML = '<div class="empty-state"><p>No posts yet. Create your first post!</p></div>';
return;
}

postList.innerHTML = state.posts.map(post => `
<article class="md3-post-card" data-post-id="${post.id}" tabindex="0" role="button">
<h2 class="md3-post-card-title">${escapeHtml(post.title)}</h2>
<p class="md3-post-card-excerpt">${escapeHtml(post.excerpt)}</p>
<div class="md3-post-card-meta">
<span>By ${escapeHtml(post.author)}</span>
<span>${formatDate(post.date)}</span>
</div>
</article>
`).join('');

postList.querySelectorAll('.md3-post-card').forEach(card => {
card.addEventListener('click', (e) => {
e.preventDefault();
const postId = parseInt(card.dataset.postId, 10);
showPostDetail(postId);
});
card.addEventListener('keydown', (e) => {
if (e.key === 'Enter' || e.key === ' ') {
e.preventDefault();
const postId = parseInt(card.dataset.postId, 10);
showPostDetail(postId);
});
});
}

function renderPostDetail(postId) {
if (!postDetail) return;

const post = state.posts.find(p => p.id === postId);
if (!post) return;

postDetail.innerHTML = `
<h1 class="md3-post-detail-title">${escapeHtml(post.title)}</h1>
<div class="md3-post-detail-meta">
<span>By ${escapeHtml(post.author)}</span>
<span>${formatDate(post.date)}</span>
</div>
<div class="md3-post-detail-content">${escapeHtml(post.content)}</div>
`;
}

function showView(viewName) {
Object.keys(views).forEach(key => {
if (views[key]) {
views[key].classList.remove('md3-view-active');
}
});

navButtons.forEach(btn => {
btn.classList.remove('md3-nav-btn-active');
if (btn.dataset.view === viewName) {
btn.classList.add('md3-nav-btn-active');
}
});

if (views[viewName]) {
views[viewName].classList.add('md3-view-active');
}

state.currentView = viewName;
}

function showPostDetail(postId) {
state.selectedPostId = postId;
renderPostDetail(postId);
showView('detail');
}

function showHome() {
state.selectedPostId = null;
renderPostList();
showView('home');
}

function showCreate() {
state.selectedPostId = null;
showView('create');
}

navButtons.forEach(btn => {
btn.addEventListener('click', (e) => {
e.preventDefault();
const viewName = btn.dataset.view;
if (viewName === 'home') {
showHome();
} else if (viewName === 'create') {
showCreate();
}
});
});

if (backBtn) {
backBtn.addEventListener('click', (e) => {
e.preventDefault();
showHome();
});
}

if (createForm) {
createForm.addEventListener('submit', (e) => {
e.preventDefault();

const titleInput = document.getElementById('post-title-input');
const excerptInput = document.getElementById('post-excerpt-input');
const contentInput = document.getElementById('post-content-input');
const authorInput = document.getElementById('post-author-input');

if (!titleInput || !excerptInput || !contentInput || !authorInput) {
return;
}

const newPost = {
id: Date.now(),
title: titleInput.value.trim(),
excerpt: excerptInput.value.trim(),
content: contentInput.value.trim(),
author: authorInput.value.trim(),
date: new Date().toISOString().split('T')[0]
};

try {
state.posts.unshift(newPost);
titleInput.value = '';
excerptInput.value = '';
contentInput.value = '';
authorInput.value = '';
showHome();
} catch (error) {
console.error('Error creating post:', error);
}
});
}

renderPostList();
showView('home');
});}, message=功能无法使用, selectId=[]}
