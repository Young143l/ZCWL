<input type=\"text\" id=\"post-title-input\" class=\"md3-text-field-input\" required aria-required=\"true\">
</div>
<div class=\"md3-text-field\">
<label for=\"post-excerpt-input\" class=\"md3-text-field-label\">Excerpt</label>
<input type=\"text\" id=\"post-excerpt-input\" class=\"md3-text-field-input\" required aria-required=\"true\">
</div>
