  --bg-primary: #0f0f23;
  --bg-secondary: #1a1a2e;
  --bg-tertiary: #16213e;
  --accent-primary: #0f3460;
  --accent-secondary: #e94560;
  --accent-tertiary: #533483;
  --text-primary: #eaeaea;
  --text-secondary: #a0a0a0;
  --text-muted: #666666;
  --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.5);
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 20px;
  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 250ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 350ms cubic-bezier(0.4, 0, 0.2, 1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  color: var(--text-primary);
}

#calculator-app {
  width: 100%;
  max-width: 400px;
  background: var(--bg-secondary);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.05);
}

#calc-display-wrapper {
  background: var(--bg-tertiary);
  padding: 24px;
  text-align: right;
  min-height: 120px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 8px;
  position: relative;
  overflow: hidden;
}

#calc-display-wrapper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(233, 69, 96, 0.05) 0%, transparent 100%);
  pointer-events: none;
}

#calc-previous-operand {
  color: var(--text-secondary);
  font-size: 1.1rem;
  font-weight: 500;
  height: 24px;
  opacity: 0.8;
  transition: opacity var(--transition-fast);
}

#calc-current-operand {
  color: var(--text-primary);
  font-size: 3rem;
  font-weight: 300;
  letter-spacing: -0.02em;
  line-height: 1.2;
  word-break: break-all;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
}

#calc-buttons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: var(--bg-primary);
  padding: 1px;
}

#calc-buttons button {
  border: none;
  outline: none;
  background: var(--bg-secondary);
  color: var(--text-primary);
  font-size: 1.4rem;
  font-weight: 500;
  padding: 24px 16px;
  cursor: pointer;
  transition: all var(--transition-fast);
  position: relative;
  overflow: hidden;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

#calc-buttons button::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

#calc-buttons button:active::before {
  width: 300px;
  height: 300px;
}

#calc-buttons button:hover {
  background: var(--bg-tertiary);
  transform: translateY(-1px);
}

#calc-buttons button:active {
  transform: translateY(0);
  transition-duration: 50ms;
}

/* 特殊按钮样式 */
#btn-clear,
#btn-delete,
#btn-percent {
  color: var(--accent-secondary);
  font-weight: 600;
}

#btn-clear:hover,
#btn-delete:hover,
#btn-percent:hover {
  background: rgba(233, 69, 96, 0.1);
}

/* 操作符按钮 */
#btn-divide,
#btn-multiply,
#btn-subtract,
#btn-add {
  color: var(--accent-tertiary);
  font-size: 1.6rem;
  font-weight: 600;
}

#btn-divide:hover,
#btn-multiply:hover,
#btn-subtract:hover,
#btn-add:hover {
  background: rgba(83, 52, 131, 0.15);
}

/* 等于按钮 */
#btn-equals {
  background: linear-gradient(135deg, var(--accent-secondary) 0%, var(--accent-tertiary) 100%);
  color: white;
  font-weight: 700;
  font-size: 1.6rem;
  grid-column: span 2;
  box-shadow: 0 4px 15px rgba(233, 69, 96, 0.3);
}

#btn-equals:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(233, 69, 96, 0.4);
  filter: brightness(1.1);
}

#btn-equals:active {
  transform: translateY(0);
  box-shadow: 0 2px 10px rgba(233, 69, 96, 0.3);
}

/* 零按钮占据两格 */
#btn-0 {
  grid-column: span 1;
}

/* 响应式设计 */
@media (max-width: 480px) {
  body {
    padding: 0;
    background: var(--bg-secondary);
  }
  
  #calculator-app {
    max-width: 100%;
    height: 100vh;
    border-radius: 0;
    display: flex;
    flex-direction: column;
  }
  
  #calc-display-wrapper {
    flex: 1;
    min-height: auto;
    padding: 32px 24px;
  }
  
  #calc-current-operand {
    font-size: 3.5rem;
  }
  
  #calc-buttons {
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
  }
  
  #calc-buttons button {
    padding: 28px 16px;
    font-size: 1.5rem;
  }
}

@media (min-width: 768px) {
  #calculator-app {
    transform: scale(1.05);
  }
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

#calculator-app {
  animation: fadeIn 0.5s var(--transition-slow) forwards;
}

/* 错误状态 */
.error {
  color: var(--accent-secondary) !important;
  animation: shake 0.5s ease-in-out;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-5px); }
  75% { transform: translateX(5px); }
}
