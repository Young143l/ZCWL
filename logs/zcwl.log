  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: var(--bg-color);
  color: var(--text-primary);
  line-height: 1.6;
  transition: background-color var(--transition-normal), color var(--transition-normal);
}

#main-container {
  max-width: 1200px;
  margin: 0 auto;
  min-height: 100vh;
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 1rem;
  padding: 1rem;
}

/* Header */
#app-header {
  background: var(--surface-color);
  border-radius: var(--radius-lg);
  padding: 1rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-color);
  backdrop-filter: blur(8px);
}

#page-title {
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: -0.025em;
  text-align: center;
  flex: 1;
  margin: 0 1rem;
}

#main-nav {
  display: flex;
  gap: 0.5rem;
  flex-shrink: 0;
}

.nav-btn {
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-secondary);
  padding: 0.5rem 1rem;
  border-radius: var(--radius-md);
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.nav-btn:hover {
  background: var(--bg-color);
  color: var(--text-primary);
}

.nav-btn.active {
  background: var(--primary-color);
  color: white;
  box-shadow: var(--shadow-sm);
}

/* Main Content */
#dynamic-content {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.view-section {
  display: none;
  animation: fadeIn var(--transition-normal) ease-out;
}

.view-section.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Cards & Layouts */
#dashboard-card, #settings-card {
  background: var(--surface-color);
  border-radius: var(--radius-lg);
  padding: 2rem;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--border-color);
}

h2 {
  font-size: 1.5rem;
  margin-bottom: 1rem;
  color: var(--text-primary);
}

p {
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
}

#action-area {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}

/* Buttons */
.btn-primary, .btn-secondary {
  padding: 0.625rem 1.25rem;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all var(--transition-fast);
  border: none;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-primary {
  background: var(--primary-color);
  color: white;
}

.btn-primary:hover {
  background: var(--primary-hover);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.btn-primary:active {
  transform: translateY(0);
}

.btn-secondary {
  background: var(--bg-color);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
}

.btn-secondary:hover {
  background: var(--border-color);
}

/* State Display */
#state-display {
  background: var(--bg-color);
  padding: 1rem;
  border-radius: var(--radius-md);
  font-family: monospace;
  font-size: 0.85rem;
  overflow-x: auto;
  white-space: pre-wrap;
  color: var(--text-secondary);
  border: 1px dashed var(--border-color);
}

/* Forms */
#settings-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-primary);
}

input[type=\"text\"],
input[type=\"email\"] {
  padding: 0.75rem;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background: var(--bg-color);
  color: var(--text-primary);
  font-size: 1rem;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

input:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
}

/* Footer & Notifications */
#app-footer {
  min-height: 60px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

#notification-area {
  min-height: 40px;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.toast {
  background: var(--surface-color);
  color: var(--text-primary);
  padding: 0.75rem 1.5rem;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  border-left: 4px solid var(--primary-color);
  animation: slideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  font-weight: 500;
}

.toast.success { border-left-color: var(--success-color); }
.toast.error { border-left-color: var(--danger-color); }

@keyframes slideUp {
  from { transform: translateY(20px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* Utility Classes */
.hidden {
  display: none !important;
}

/* Loading State */
.loading {
  position: relative;
  color: transparent;
  pointer-events: none;
}

.loading::after {
  content: \"\";
  position: absolute;
  width: 1em;
  height: 1em;
  top: 50%;
  left: 50%;
  margin-top: -0.5em;
  margin-left: -0.5em;
  border: 2px solid rgba(255,255,255,0.7);
  border-radius: 50%;
  border-top-color: transparent;
  animation: spin 0.8s linear infinite;
}

.loading.btn-secondary::after {
  border: 2px solid var(--text-secondary);
  border-top-color: transparent;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Responsive */
@media (max-width: 768px) {
  #app-header {
    flex-direction: column;
    gap: 1rem;
    align-items: stretch;
  }
  
  #page-title {
    margin: 0;
  }
  
  #main-nav {
    justify-content: space-between;
  }
  
  .nav-btn {
    flex: 1;
    text-align: center;
  }
  
  #dashboard-card, #settings-card {
    padding: 1.5rem;
  }
}", javascript: "document.addEventListener(\"DOMContentLoaded\", () => {
  // --- State Management ---
  const AppState = {
    currentView: 'dashboard',
    theme: 'light',
    isLoading: false,
    formData: {
      username: '',
      email: ''
    }
  };

  // --- Selectors & Elements ---
  const els = {
    body: document.body,
    navHome: document.getElementById('nav-home'),
    navSettings: document.getElementById('nav-settings'),
    toggleTheme: document.getElementById('toggle-theme-btn'),
    views: {
      dashboard: document.getElementById('view-dashboard'),
      settings: document.getElementById('view-settings')
    },
    primaryAction: document.getElementById('primary-action-btn'),
    resetBtn: document.getElementById('reset-state-btn'),
    stateDisplay: document.getElementById('state-display'),
    statusText: document.getElementById('status-text'),
    settingsForm: document.getElementById('settings-form'),
    userInput: document.getElementById('user-input'),
    emailInput: document.getElementById('email-input'),
    saveBtn: document.getElementById('save-settings-btn'),
    notificationArea: document.getElementById('notification-area')
  };

  // --- Utility Functions ---
  const safeExecute = (fn, errorMsg) => {
    try {
      fn();
    } catch (error) {
      console.error(error);
      showToast(errorMsg || '发生意外错误。', 'error');
    }
  };

  const showToast = (message, type = 'info') => {
    if (!els.notificationArea) return;
    
    // Clear existing toasts
    els.notificationArea.innerHTML = '';
    
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.textContent = message;
    toast.setAttribute('role', 'alert');
    toast.setAttribute('aria-live', 'polite');
    
    els.notificationArea.appendChild(toast);
    
    // Auto remove after 3 seconds
    setTimeout(() => {
      if (toast.parentNode) {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(20px)';
        setTimeout(() => toast.remove(), 300);
      }
    }, 3000);
  };

  const updateStateDisplay = () => {
    if (!els.stateDisplay) return;
    els.stateDisplay.textContent = JSON.stringify(AppState, null, 2);
  };

  const setLoading = (isLoading) => {
    AppState.isLoading = isLoading;
    
    if (isLoading) {
      els.primaryAction.classList.add('loading');
      els.primaryAction.disabled = true;
      els.statusText.textContent = '处理中...';
    } else {
      els.primaryAction.classList.remove('loading');
      els.primaryAction.disabled = false;
      els.statusText.textContent = '系统就绪。';
    }
  };

  // --- View Logic ---
  const switchView = (viewName) => {
    if (!els.views[viewName]) return;
    
    // Update State
    AppState.currentView = viewName;
    
    // Update UI Classes
    Object.keys(els.views).forEach(key => {
      if (key === viewName) {
        els.views[key].classList.remove('hidden');
        els.views[key].classList.add('active');
      } else {
        els.views[key].classList.remove('active');
        els.views[key].classList.add('hidden');
      }
    });

    // Update Nav Active State
    if (els.navHome && els.navSettings) {
      els.navHome.classList.toggle('active', viewName === 'dashboard');
      els.navSettings.classList.toggle('active', viewName === 'settings');
    }
    
    updateStateDisplay();
  };

  // --- Event Handlers ---
  const handleNavClick = (e, view) => {
    e.preventDefault();
    switchView(view);
  };

  const handleThemeToggle = (e) => {
    e.preventDefault();
    AppState.theme = AppState.theme === 'light' ? 'dark' : 'light';
    els.body.setAttribute('data-theme', AppState.theme);
    showToast(`已切换至 ${AppState.theme === 'light' ? '浅色' : '深色'} 模式`, 'success');
    updateStateDisplay();
  };

  const handlePrimaryAction = async (e) => {
    e.preventDefault();
    if (AppState.isLoading) return;

    setLoading(true);

    // Simulate async operation
    await new Promise(resolve => setTimeout(resolve, 1500));

    safeExecute(() => {
      setLoading(false);
      showToast('操作已成功完成！', 'success');
      els.statusText.textContent = '操作完成。';
    }, '操作失败');
  };

  const handleReset = (e) => {
    e.preventDefault();
    AppState.formData = { username: '', email: '' };
    if (els.userInput) els.userInput.value = '';
    if (els.emailInput) els.emailInput.value = '';
    els.statusText.textContent = '状态已重置。';
    showToast('表单和状态已清除。', 'info');
    updateStateDisplay();
  };

  const handleFormSubmit = (e) => {
    e.preventDefault();
    
    if (AppState.isLoading) return;
    
    const username = els.userInput.value.trim();
    const email = els.emailInput.value.trim();

    if (!username) {
      showToast('用户名为必填项', 'error');
      return;
    }

    // Update State
    AppState.formData.username = username;
    AppState.formData.email = email;

    setLoading(true);

    // Simulate API call
    setTimeout(() => {
      safeExecute(() => {
        setLoading(false);
        showToast('设置保存成功！', 'success');
        els.statusText.textContent = `欢迎，${username}`;
        updateStateDisplay();
        // Optional: Switch back to dashboard
        switchView('dashboard');
      }, '保存失败');
    }, 1000);
  };

  // --- Initialization ---
  const init = () => {
    // Bind Events with Existence Checks
    if (els.navHome) els.navHome.addEventListener('click', (e) => handleNavClick(e, 'dashboard'));
    if (els.navSettings) els.navSettings.addEventListener('click', (e) => handleNavClick(e, 'settings'));
    if (els.toggleTheme) els.toggleTheme.addEventListener('click', handleThemeToggle);
    if (els.primaryAction) els.primaryAction.addEventListener('click', handlePrimaryAction);
    if (els.resetBtn) els.resetBtn.addEventListener('click', handleReset);
    if (els.settingsForm) els.settingsForm.addEventListener('submit', handleFormSubmit);

    // Initial Render
    updateStateDisplay();
    console.log('架构初始化成功。');
  };

  // Run Init
  init();
});"}`
