    /* 色板 */
    --color-primary: #3a86ff;
    --color-primary-dark: #2a76ef;
    --color-secondary: #8338ec;
    --color-accent: #ff006e;
    --color-background: #ffffff;
    --color-surface: #f8f9fa;
    --color-surface-variant: #e9ecef;
    --color-text-primary: #212529;
    --color-text-secondary: #6c757d;
    --color-border: #dee2e6;
    --color-shadow: rgba(0, 0, 0, 0.08);
    --color-shadow-heavy: rgba(0, 0, 0, 0.15);
    --color-success: #28a745;
    --color-error: #dc3545;

    /* 间距系统 */
    --spacing-xs: 0.25rem;
    --spacing-sm: 0.5rem;
    --spacing-md: 1rem;
    --spacing-lg: 1.5rem;
    --spacing-xl: 2rem;
    --spacing-xxl: 3rem;

    /* 排版系统 */
    --font-family-base: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;
    --font-family-heading: Georgia, \"Times New Roman\", Times, serif;
    --font-size-xs: 0.875rem;
    --font-size-sm: 1rem;
    --font-size-md: 1.25rem;
    --font-size-lg: 1.5rem;
    --font-size-xl: 2rem;
    --font-size-xxl: 2.5rem;
    --line-height-tight: 1.25;
    --line-height-normal: 1.5;
    --line-height-loose: 1.75;

    /* 过渡与效果 */
    --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-normal: 300ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 500ms cubic-bezier(0.4, 0, 0.2, 1);
    --shadow-normal: 0 4px 6px var(--color-shadow);
    --shadow-heavy: 0 10px 15px var(--color-shadow-heavy);
    --shadow-inset: inset 0 2px 4px var(--color-shadow);
    --border-radius-sm: 4px;
    --border-radius-md: 8px;
    --border-radius-lg: 12px;
    --border-radius-full:扣;
}

/* 基础重置与盒模型 */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-size: 16px;
    scroll-behavior: smooth;
}

body {
    font-family: var(--font-family-base);
    color: var(--color-text-primary);
    background-color: var(--color-background);
    line-height: var(--line-height-normal);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* 容器 */
.container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
}

/* 头部 */
#main-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--spacing-md) 0;
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(8px);
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

#site-title {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    color: var(--color-primary);
    margin: 0;
}

.nav-list {
    display: flex;
    gap: var(--spacing-lg);
    list-style: none;
}

.nav-btn {
    background: none;
    border: none;
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    cursor: pointer;
    border-radius: var(--border-radius-md);
    transition: color var(--transition-fast), background-color var(--transition-fast);
}

.nav-btn:hover, .nav-btn.active {
    color: var(--color-primary);
    background-color: var(--color-surface-variant);
}

.mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: var(--font-size-lg);
    color: var(--color-text-primary);
    cursor: pointer;
    padding: var(--spacing-sm);
}

/* 主要内容区域 */
#app-main {
    flex: 1;
    padding: var(--spacing-xl) 0;
}

.loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-md);
    padding: var(--spacing-xxl);
}

.loader {
    width: 50px;
    height: 50px;
    border: 5px solid var(--color-surface-variant);
    border-top-color: var(--color-primary);
    border-radius: var(--border-radius-full);
    animation: spin 1s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.view {
    animation: fadeIn var(--transition-normal);
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* 首页视图 */
.hero-section {
    text-align: center;
    padding: var(--spacing-xxl) 0;
    background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-background) 100%);
    border-radius: var(--border-radius-lg);
    margin-bottom: var(--spacing-xl);
}

#hero-title {
    font-size: var(--font-size-xxl);
    margin-bottom: var(--spacing-md);
}

#hero-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xl);
}

.featured-section h3 {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-lg);
}

/* 文章网格 */
.articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--spacing-lg);
}

/* 文章卡片 */
.article-card {
    background-color: var(--color-surface);
    border-radius: var(--border-radius-md);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-normal);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
    cursor: pointer;
    border: 1px solid var(--color-border);
}

.article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-heavy);
}

.article-card h3 {
    font-size: var(--font-size-md);
    margin-bottom: var(--spacing-sm);
    color: var(--color-primary);
}

.article-card .excerpt {
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-md);
}

.article-card .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
}

.tag {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: var(--color-surface-variant);
    color: var(--color-primary);
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-xs);
}

/* 文章列表视图控件 */
.articles-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
}

.search-box {
    display: flex;
    gap: var(--spacing-sm);
    flex: 1;
    min-width: 250px;
}

#articles-search-input {
    flex: 1;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    font-size: var(--font-size-sm);
    transition: border-color var(--transition-fast);
}

#articles-search-input:focus {
    outline: none;
    border-color: var(--color-primary);
}

.filter-tags {
    display: flex;
    gap: var(--spacing-sm);
}

.tag-btn {
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-surface-variant);
    border: none;
    border-radius: var(--border-radius-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
}

.tag-btn:hover, .tag-btn.active {
    background-color: var(--color-primary);
    color: white;
}

/* 分页 */
.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-xl);
}

.pagination-btn {
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    cursor: pointer;
    transition: background-color var(--transition-fast);
}

.pagination-btn:hover:not([disabled]) {
    background-color: var(--color-surface-variant);
}

.pagination-btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
}

.pagination-info {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
}

/* 文章详情视图 */
.back-btn {
    margin-bottom: var(--spacing-lg);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.article-detail {
    background-color: var(--color-surface);
    padding: var(--spacing-xl);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-normal);
}

.article-detail h2 {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-md);
    color: var(--color-primary);
}

.article-detail .content {
    font-size: var(--font-size-md);
    line-height: var(--line-height-loose);
    margin-bottom: var(--spacing-lg);
}

.article-detail .detail-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    border-top: 1px solid var(--color-border);
    padding-top: var(--spacing-md);
}

/* 关于视图 */
.about-content {
    margin-bottom: var(--spacing-xl);
}

.contact-info ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
}

.contact-info li {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

/* 创建文章视图 */
.create-form {
    background-color: var(--color-surface);
    padding: var(--spacing-xl);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-normal);
}

.form-group {
    margin-bottom: var(--spacing-lg);
}

.form-group label {
    display: block;
    margin-bottom: var(--spacing-sm);
    font-weight: bold;
}

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;
    padding: var(--spacing-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    font-size: var(--font-size-sm);
    transition: border-color var(--transition-fast);
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    outline: none;
    border-color: var(--color-primary);
}

.form-actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: flex-end;
}

/* 按钮样式 */
.btn-primary, .btn-secondary, .btn-icon {
    padding: var(--spacing-sm) var(--spacing-lg);
    border: none;
    border-radius: var(--border-radius-md);
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
}

.btn-primary {
    background-color: var(--color-primary);
    color: white;
}

.btn-primary:hover {
    background-color: var(--color-primary-dark);
}

.btn-secondary {
    background-color: var(--color-surface-variant);
    color: var(--color-text-primary);
}

.btn-secondary:hover {
    background-color: var(--color-border);
}

.btn-icon {
    background: none;
    color: var(--color-text-primary);
    padding: var(--spacing-sm);
}

.btn-icon:hover {
    background-color: var(--color-surface-variant);
}

/* 页脚 */
#main-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--spacing-lg) 0;
    text-align: center;
    color: var(--color-text-secondary);
}

.footer-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
}

/* 响应式设计 */
@media (max-width: 768px) {
    .nav-list {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: var(--color-surface);
        padding: var(--spacing-md);
        box-shadow: var(--shadow-heavy);
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .nav-list.active {
        display: flex;
    }

    .mobile-menu-toggle {
        display: block;
    }

    .articles-grid {
        grid-template-columns: 1fr;
    }

    .articles-controls {
        flex-direction: column;
        align-items: stretch;
    }

    .search-box {
        min-width: auto;
    }

    .form-actions {
        flex-direction: column;
    }
}

/* 无障碍增强 */
button:focus,
input:focus,
textarea:focus,
select:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
}

[hidden] {
    display: none !important;
}", javascript: "document.addEventListener('DOMContentLoaded', () => {
    // 应用状态
    const APP_STATE = {
        currentView: 'home',
        articles: [],
        filteredArticles: [],
        currentPage: 1,
        articlesPerPage: 6,
        searchQuery: '',
        activeTag: 'all',
        isLoading: false,
        mobileMenuOpen: false
    };

    // DOM 元素引用（严格的存在性检查）
    const elements = {
        appMain: document.getElementById('app-main'),
        loadingState: document.getElementById('loading-state'),
        views: {
            home: document.getElementById('view-home'),
            articles: document.getElementById('view-articles'),
            articleDetail: document.getElementById('view-article-detail'),
            about: document.getElementById('view-about'),
            create: document.getElementById('view-create')
        },
        navButtons: {
            home: document.getElementById('nav-btn-home'),
            articles: document.getElementById('nav-btn-articles'),
            about: document.getElementById('nav-btn-about')
        },
        featuredArticlesList: document.getElementById('featured-articles-list'),
        articlesList: document.getElementById('articles-list'),
        articlesSearchInput: document.getElementById('articles-search-input'),
        articlesSearchBtn: document.getElementById('articles-search-btn'),
        filterButtons: {
            all: document.getElementById('filter-btn-all'),
            tech: document.getElementById('filter-btn-tech'),
            design: document.getElementById('filter-btn-design'),
            life: document.getElementById('filter-btn-life')
        },
        pagination: {
            prev: document.getElementById('pagination-btn-prev'),
            next: document.getElementById('pagination-btn-next'),
            info: document.getElementById('pagination-info')
        },
        articleDetailContent: document.getElementById('article-detail-content'),
        detailBackBtn: document.getElementById('detail-back-btn'),
        heroActionBtn: document.getElementById('hero-action-btn'),
        mobileMenuToggle: document.getElementById('mobile-menu-toggle'),
        mainNav: document.getElementById('main-nav'),
        navList: document.querySelector('.nav-list'),
        createForm: document.getElementById('article-create-form'),
        createSubmitBtn: document.getElementById('create-submit-btn'),
        createCancelBtn: document.getElementById('create-cancel-btn'),
        currentYear: document.getElementById('current-year')
    };

    // 初始化检查
    if (!elements.appMain) {
        console.error('主应用容器未找到');
        return;
    }

    // 模拟数据源
    const mockArticles = [
        { id: 1, title: '现代 Web 开发架构演进', excerpt: '探讨从传统 MVC 到现代组件化、数据驱动架构的变化。', content: '文章详情内容：现代 Web 开发架构演进...', tag: 'technology', date: '2023-10-01', author: '架构师' },
        { id: 2, title: '极简主义设计哲学', excerpt: '如何在数字产品中实践极简主义，提升用户体验。', content: '文章详情内容：极简主义设计哲学...', tag: 'design', date: '2023-09-15', author: '设计师' },
        { id: 3, title: '保持专注的日常习惯', excerpt: '分享几种有助于在繁忙工作中保持深度专注的方法。', content: '文章详情内容：保持专注的日常习惯...', tag: 'life', date: '2023-09-01', author: '作者' },
        { id: 4, title: 'JavaScript 状态管理模式', excerpt: '在无框架环境下实现清晰、可维护的状态管理。', content: '文章详情内容：JavaScript 状态管理模式...', tag: 'technology', date: '2023-08-20', author: '开发者' },
        { id: 5, title: '色彩理论与界面设计', excerpt: '理解色彩如何影响用户情绪与产品感知。', content: '文章详情内容：色彩理论与界面设计...', tag: 'design', date: '2023-08-05', author: '设计师' },
        { id: 6, title: '远程工作高效协作指南', excerpt: '工具与流程建议，帮助团队在远程环境下高效协作。', content: '文章详情内容：远程工作高效协作指南...', tag: 'life', date: '2023-07-28', author: '团队领导' },
        { id: 7, title: 'CSS Grid 布局实战', excerpt: '使用 CSS Grid 构建复杂响应式布局的详细指南。', content: '文章详情内容：CSS Grid 布局实战...', tag: 'technology', date: '2023-07-10', author: '前端工程师' },
        { id: 8, title: '无障碍设计基础', excerpt: '确保 Web 内容对所有用户可访问的关键原则。', content: '文章详情内容：无障碍设计基础...', tag: 'design', date: '2023-06-25', author: 'UX 专家' },
        { id: 9, title: '健康的工作与生活平衡', excerpt: '在高压技术行业中维持身心健康的方法。', content: '文章详情内容：健康的工作与生活平衡...', tag: 'life', date: '2023-06-10', author: '健康顾问' }
    ];

    // 状态管理函数
    function setLoading(loading) {
        APP_STATE.isLoading = loading;
        if (elements.loadingState) {
            elements.loadingState.hidden = !loading;
        }
        // 根据加载状态禁用或启用交互元素
        const interactiveElements = [
            ...Object.values(elements.navButtons),
            elements.articlesSearchBtn,
            ...Object.values(elements.filterButtons),
            elements.pagination.prev,
            elements.pagination.next,
            elements.heroActionBtn
        ];
        interactiveElements.forEach(el => {
            if (el) el.disabled = loading;
        });
    }

    function setCurrentView(view) {
        APP_STATE.currentView = view;
        // 隐藏所有视图
        Object.values(elements.views).forEach(viewEl => {
            if (viewEl) viewEl.hidden = true;
        });
        // 显示当前视图
        const currentViewEl = elements.views[view];
        if (currentViewEl) {
            currentViewEl.hidden = false;
        }
        // 更新导航按钮状态
        Object.keys(elements.navButtons).forEach(key => {
            const btn = elements.navButtons[key];
            if (btn) {
                btn.classList.toggle('active', key === view);
            }
        });
        // 根据视图执行特定操作
        switch (view) {
            case 'home':
                renderFeaturedArticles();
                break;
            case 'articles':
                filterAndRenderArticles();
                updatePagination();
                break;
            case 'about':
                // 无额外操作
                break;
        }
    }

    function setActiveTag(tag) {
        APP_STATE.activeTag = tag;
        // 更新标签按钮状态
        Object.keys(elements.filterButtons).forEach(key => {
            const btn = elements.filterButtons[key];
            if (btn) {
                btn.classList.toggle('active', key === tag);
            }
        });
        filterAndRenderArticles();
        updatePagination();
    }

    function setSearchQuery(query) {
        APP_STATE.searchQuery = query.trim().toLowerCase();
        filterAndRenderArticles();
        updatePagination();
    }

    function setCurrentPage(page) {
        APP_STATE.currentPage = page;
        renderArticlesPage();
        updatePagination();
    }

    // 数据过滤与处理
    function filterArticles() {
        try {
            let filtered = mockArticles;
            // 按标签过滤
            if (APP_STATE.activeTag !== 'all') {
                filtered = filtered.filter(article => article.tag === APP_STATE.activeTag);
            }
            // 按搜索词过滤
            if (APP_STATE.searchQuery) {
                filtered = filtered.filter(article =>
                    article.title.toLowerCase().includes(APP_STATE.searchQuery) ||
                    article.excerpt.toLowerCase().includes(APP_STATE.searchQuery)
                );
            }
            APP_STATE.filteredArticles = filtered;
        } catch (error) {
            console.error('过滤文章时出错:', error);
            APP_STATE.filteredArticles = mockArticles;
        }
    }

    // 渲染函数
    function renderFeaturedArticles() {
        if (!elements.featuredArticlesList) return;
        const featured = mockArticles.slice(0, 3); // 取前三篇作为精选
        elements.featuredArticlesList.innerHTML = featured.map(article =>
            `<div class=\"article-card\" data-id=\"${article.id}\" role=\"button\" tabindex=\"0\" aria-label=\"阅读文章：${article.title}\">
                <h3>${article.title}</h3>
                <p class=\"excerpt\">${article.excerpt}</p>
                <div class=\"meta\">
                    <span class=\"tag\">${article.tag}</span>
                    <span>${article.date}</span>
                </div>
            </div>`
        ).join('');
        // 为精选文章卡片绑定点击事件
        elements.featuredArticlesList.querySelectorAll('.article-card').forEach(card => {
            card.addEventListener('click', handleArticleCardClick);
            card.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    handleArticleCardClick(e);
                }
            });
        });
    }

    function filterAndRenderArticles() {
        filterArticles();
        renderArticlesPage();
    }

    function renderArticlesPage() {
        if (!elements.articlesList) return;
        const startIndex = (APP_STATE.currentPage - 1) * APP_STATE.articlesPerPage;
        const endIndex = startIndex + APP_STATE.articlesPerPage;
        const articlesToShow = APP_STATE.filteredArticles.slice(startIndex, endIndex);
        elements.articlesList.innerHTML = articlesToShow.map(article =>
            `<div class=\"article-card\" data-id=\"${article.id}\" role=\"button\" tabindex=\"0\" aria-label=\"阅读文章：${article.title}\">
                <h3>${article.title}</h3>
                <p class=\"excerpt\">${article.excerpt}</p>
                <div class=\"meta\">
                    <span class=\"tag\">${article.tag}</span>
                    <span>${article.date}</span>
                </div>
            </div>`
        ).join('');
        // 为文章卡片绑定点击事件
        elements.articlesList.querySelectorAll('.article-card').forEach(card => {
            card.addEventListener('click', handleArticleCardClick);
            card.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    handleArticleCardClick(e);
                }
            });
        });
    }

    function renderArticleDetail(id) {
        if (!elements.articleDetailContent) return;
        const article = mockArticles.find(a => a.id === id);
        if (!article) {
            elements.articleDetailContent.innerHTML = '<p>文章未找到。</p>';
            return;
        }
        elements.articleDetailContent.innerHTML = `
            <h2>${article.title}</h2>
            <div class=\"content\">${article.content}</div>
            <div class=\"detail-meta\">
                <span class=\"tag\">${article.tag}</span>
                <span>${article.date} | 作者：${article.author}</span>
            </div>
        `;
        setCurrentView('articleDetail');
    }

    function updatePagination() {
        if (!elements.pagination.prev || !elements.pagination.next || !elements.pagination.info) return;
        const totalPages = Math.ceil(APP_STATE.filteredArticles.length / APP_STATE.articlesPerPage);
        elements.pagination.prev.disabled = APP_STATE.currentPage === 1;
        elements.pagination.next.disabled = APP_STATE.currentPage === totalPages || totalPages === 0;
        elements.pagination.info.textContent = `第 ${APP_STATE.currentPage} / ${totalPages} 页`;
    }

    // 事件处理
    function handleNavButtonClick(e) {
        e.preventDefault();
        const view = e.currentTarget.dataset.view;
        if (view && elements.views[view]) {
            setCurrentView(view);
        }
        // 移动端菜单自动关闭
        if (APP_STATE.mobileMenuOpen) {
            toggleMobileMenu(false);
        }
    }

    function handleArticleCardClick(e) {
        e.preventDefault();
        const card = e.currentTarget;
        const id = parseInt(card.dataset.id);
        if (id) {
            renderArticleDetail(id);
        }
    }

    function handleSearch(e) {
        e.preventDefault();
        if (!elements.articlesSearchInput) return;
        setSearchQuery(elements.articlesSearchInput.value);
    }

    function handleFilterClick(e) {
        e.preventDefault();
        const tag = e.currentTarget.dataset.tag;
        if (tag) {
            setActiveTag(tag);
        }
    }

    function handlePaginationClick(e, direction) {
        e.preventDefault();
        if (direction === 'prev' && APP_STATE.currentPage > 1) {
            setCurrentPage(APP_STATE.currentPage - 1);
        } else if (direction === 'next') {
            const totalPages = Math.ceil(APP_STATE.filteredArticles.length / APP_STATE.articlesPerPage);
            if (APP_STATE.currentPage < totalPages) {
                setCurrentPage(APP_STATE.currentPage + 1);
            }
        }
    }

    function handleDetailBackClick(e) {
        e.preventDefault();
        setCurrentView('articles');
    }

    function handleHeroActionClick(e) {
        e.preventDefault();
        setCurrentView('articles');
    }

    function toggleMobileMenu(open) {
        APP_STATE.mobileMenuOpen = open;
        if (elements.navList) {
            elements.navList.classList.toggle('active', open);
        }
        if (elements.mobileMenuToggle) {
            elements.mobileMenuToggle.setAttribute('aria-expanded', open);
        }
    }

    function handleCreateFormSubmit(e) {
        e.preventDefault();
        // 模拟创建文章过程
        setLoading(true);
        setTimeout(() => {
            alert('文章创建功能为演示用途。在实际应用中，这里会连接到后端API。');
            setLoading(false);
            setCurrentView('articles');
        }, 1000);
    }

    // 事件绑定
    function bindEvents() {
        // 导航按钮
        Object.values(elements.navButtons).forEach(btn => {
            if (btn) btn.addEventListener('click', handleNavButtonClick);
        });

        // 文章搜索
        if (elements.articlesSearchBtn) {
            elements.articlesSearchBtn.addEventListener('click', handleSearch);
        }
        if (elements.articlesSearchInput) {
            elements.articlesSearchInput.addEventListener('input', handleSearch);
        }

        // 标签过滤
        Object.values(elements.filterButtons).forEach(btn => {
            if (btn) btn.addEventListener('click', handleFilterClick);
        });

        // 分页
        if (elements.pagination.prev) {
            elements.pagination.prev.addEventListener('click', (e) => handlePaginationClick(e, 'prev'));
        }
        if (elements.pagination.next) {
            elements.pagination.next.addEventListener('click', (e) => handlePaginationClick(e, 'next'));
        }

        // 文章详情返回
        if (elements.detailBackBtn) {
            elements.detailBackBtn.addEventListener('click', handleDetailBackClick);
        }

        // 首页行动按钮
        if (elements.heroActionBtn) {
            elements.heroActionBtn.addEventListener('click', handleHeroActionClick);
        }

        // 移动端菜单切换
        if (elements.mobileMenuToggle) {
            elements.mobileMenuToggle.addEventListener('click', (e) => {
                e.preventDefault();
                toggleMobileMenu(!APP_STATE.mobileMenuOpen);
            });
        }

        // 创建文章表单
        if (elements.createForm) {
            elements.createForm.addEventListener('submit', handleCreateFormSubmit);
        }
        if (elements.createCancelBtn) {
            elements.createCancelBtn.addEventListener('click', (e) => {
                e.preventDefault();
                setCurrentView('articles');
            });
        }

        // 点击外部关闭移动菜单
        document.addEventListener('click', (e) => {
            if (APP_STATE.mobileMenuOpen && !elements.mobileMenuToggle.contains(e.target) && !elements.navList.contains(e.target)) {
                toggleMobileMenu(false);
            }
        });
    }

    // 初始化应用
    function initApp() {
        setLoading(true);
        // 模拟数据加载延迟
        setTimeout(() => {
            APP_STATE.articles = mockArticles;
            APP_STATE.filteredArticles = mockArticles;
            setLoading(false);
            setCurrentView('home');
            updatePagination();
            // 设置当前年份
            if (elements.currentYear) {
                elements.currentYear.textContent = new Date().getFullYear();
            }
        }, 500);
        bindEvents();
    }

    // 启动应用
    initApp();
});"}`
