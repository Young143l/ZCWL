        { id: 2, title: '极简主义设计哲学', excerpt: '如何在数字产品中实践极简主义，提升用户体验。', content: '文章详情内容：极简主义设计哲学...', tag: 'design', date: '2023-09-15', author: '设计师' },
        { id: 3, title: '保持专注的日常习惯', excerpt: '分享几种有助于在繁忙工作中保持深度专注的方法。', content: '文章详情内容：保持专注的日常习惯...', tag: 'life', date: '2023-09-01', author: '作者' },
        { id: 4, title: 'JavaScript 状态管理模式', excerpt: '在无框架环境下实现清晰、可维护的状态管理。', content: '文章详情内容：JavaScript 状态管理模式...', tag: 'technology', date: '2023-08-20', author: '开发者' },
        { id: 5, title: '色彩理论与界面设计', excerpt: '理解色彩如何影响用户情绪与产品感知。', content: '文章详情内容：色彩理论与界面设计...', tag: 'design', date: '2023-08-05', author: '设计师' },
        { id: 6, title: '远程工作高效协作指南', excerpt: '工具与流程建议，帮助团队在远程环境下高效协作。', content: '文章详情内容：远程工作高效协作指南...', tag: 'life', date: '2023-07-28', author: '团队领导' },
