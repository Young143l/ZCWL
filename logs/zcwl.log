}, javascript=document.addEventListener("DOMContentLoaded", () => {
    // 1. 状态管理 (State Management)
    const state = {
        currentInput: '0',
        previousInput: '',
        operator: null,
        shouldResetScreen: false,
        calculationHistory: ''
    };

    // 2. DOM 元素引用 (DOM References)
    const els = {
        app: document.getElementById('calc-app'),
        keypad: document.getElementById('calc-keypad'),
        displayMain: document.getElementById('calc-display-main'),
        displayHistory: document.getElementById('calc-display-history')
    };

    // 3. 防御式检查 (Safety Check)
    if (!els.app || !els.keypad || !els.displayMain || !els.displayHistory) {
        console.error('Critical DOM elements missing. Calculator cannot initialize.');
        return;
    }

    // 4. 按钮配置 (Button Configuration)
    // 使用语义化 ID 以便未来扩展或测试
    const buttons = [
        { id: 'btn-clear', label: 'AC', type: 'action', action: 'clear' },
        { id: 'btn-sign', label: '+/-', type: 'action', action: 'toggleSign' },
        { id: 'btn-percent', label: '%', type: 'action', action: 'percent' },
        { id: 'btn-divide', label: '÷', type: 'operator', value: '/', idName: 'op-divide' },
        
        { id: 'btn-7', label: '7', type: 'number', value: '7' },
        { id: 'btn-8', label: '8', type: 'number', value: '8' },
        { id: 'btn-9', label: '9', type: 'number', value: '9' },
        { id: 'btn-multiply', label: '×', type: 'operator', value: '*', idName: 'op-multiply' },
        
        { id: 'btn-4', label: '4', type: 'number', value: '4' },
        { id: 'btn-5', label: '5', type: 'number', value: '5' },
        { id: 'btn-6', label: '6', type: 'number', value: '6' },
        { id: 'btn-subtract', label: '-', type: 'operator', value: '-', idName: 'op-subtract' },
        
        { id: 'btn-1', label: '1', type: 'number', value: '1' },
        { id: 'btn-2', label: '2', type: 'number', value: '2' },
        { id: 'btn-3', label: '3', type: 'number', value: '3' },
        { id: 'btn-add', label: '+', type: 'operator', value: '+', idName: 'op-add' },
        
        { id: 'btn-0', label: '0', type: 'number', value: '0', wide: true },
        { id: 'btn-decimal', label: '.', type: 'number', value: '.' },
        { id: 'btn-equals', label: '=', type: 'equals', action: 'calculate', idName: 'btn-equals' }
    ];

    // 5. 核心逻辑 (Core Logic)
    const Calculator = {
        appendNumber: (num) => {
            if (state.currentInput === '0' && num !== '.') {
                state.currentInput = num;
            } else if (state.shouldResetScreen) {
                state.currentInput = num;
                state.shouldResetScreen = false;
            } else {
                if (num === '.' && state.currentInput.includes('.')) return;
                state.currentInput += num;
            }
            updateDisplay();
        },

        chooseOperator: (op) => {
            if (state.currentInput === '') return;
            
            if (state.previousInput !== '') {
                Calculator.compute();
            }
            
            state.operator = op;
            state.previousInput = state.currentInput;
            state.shouldResetScreen = true;
            state.calculationHistory = `${state.previousInput} ${getOperatorSymbol(op)}`;
            
            updateDisplay();
            updateOperatorUI(op);
        },

        compute: () => {
            let computation;
            const prev = parseFloat(state.previousInput);
            const current = parseFloat(state.currentInput);
            
            if (isNaN(prev) || isNaN(current)) return;

            try {
                switch (state.operator) {
                    case '+':
                        computation = prev + current;
                        break;
                    case '-':
                        computation = prev - current;
                        break;
                    case '*':
                        computation = prev * current;
                        break;
                    case '/':
                        if (current === 0) {
                            throw new Error('Division by zero');
                        }
                        computation = prev / current;
                        break;
                    default:
                        return;
                }

                // 处理浮点数精度问题
                state.currentInput = parseFloat(computation.toFixed(10)).toString();
                state.operator = null;
                state.previousInput = '';
                state.shouldResetScreen = true;
                state.calculationHistory = '';
                
                updateDisplay();
                updateOperatorUI(null);
                
                // 触发视觉反馈
                els.displayMain.classList.add('pop-anim');
                setTimeout(() => els.displayMain.classList.remove('pop-anim'), 150);

            } catch (error) {
                showError('Error');
            }
        },

        clear: () => {
            state.currentInput = '0';
            state.previousInput = '';
            state.operator = null;
            state.shouldResetScreen = false;
            state.calculationHistory = '';
            updateDisplay();
            updateOperatorUI(null);
        },

        toggleSign: () => {
            state.currentInput = (parseFloat(state.currentInput) * -1).toString();
            updateDisplay();
        },

        percent: () => {
            state.currentInput = (parseFloat(state.currentInput) / 100).toString();
            updateDisplay();
        }
    };

    // 6. 辅助函数 (Helpers)
    const getOperatorSymbol = (op) => {
        const map = { '+': '+', '-': '-', '*': '×', '/': '÷' };
        return map[op] || '';
    };

    const updateDisplay = () => {
        // 格式化大数字 (e.g. 1000000 -> 1,000,000)
        const formatNumber = (numStr) => {
            if (numStr === 'Error') return numStr;
            const parts = numStr.split('.');
            parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            return parts.join('.');
        };

