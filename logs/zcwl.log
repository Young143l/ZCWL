}, javascript=document.addEventListener("DOMContentLoaded", () => {
  // Strict existence checks
  const form = document.getElementById("login-form");
  const usernameInput = document.getElementById("input-username");
  const passwordInput = document.getElementById("input-password");
  const submitBtn = document.getElementById("submit-btn");
  const statusMsg = document.getElementById("status-message");

  if (!form || !usernameInput || !passwordInput || !submitBtn || !statusMsg) {
    console.error("Critical Error: One or more DOM elements are missing.");
    return;
  }

  // State management
  const setState = (state) => {
    // Reset UI
    submitBtn.disabled = state.isLoading;
    submitBtn.textContent = state.isLoading ? "Authenticating..." : "Sign In";
    
    // Manage status message
    statusMsg.textContent = state.message || "";
    statusMsg.className = state.type ? state.type : "";
    
    // Handle focus for accessibility
    if (state.type === "error") {
      passwordInput.focus();
    }
  };

  // Form Submission Handler
  form.addEventListener("submit", async (e) => {
    e.preventDefault(); // Prevent default page refresh

    const username = usernameInput.value.trim();
    const password = passwordInput.value.trim();

    // Validation
    if (!username || !password) {
      setState({
        isLoading: false,
        message: "Please fill in all fields.",
        type: "error"
      });
      return;
    }

    // Simulate API Call
    setState({ isLoading: true, message: "", type: "" });

    try {
      // Mocking network delay
      await new Promise((resolve, reject) => {
        setTimeout(() => {
          // Mock credentials check
          if (username === "admin" && password === "password123") {
            resolve();
          } else {
            reject(new Error("Invalid credentials"));
          }
        }, 1500);
      });

      // Success State
      setState({
        isLoading: false,
        message: "Login Successful! Redirecting...",
        type: "success"
      });

      // Simulate SPA Redirect (Visual Feedback)
      document.body.style.transition = "opacity 0.5s ease";
      document.body.style.opacity = "0";
      
      setTimeout(() => {
        // In a real SPA, we would render a new view here.
        // For this demo, we simulate a refresh or dashboard view.
        alert(`Welcome, ${username}!`);
        location.reload(); 
      }, 1000);

    } catch (error) {
      // Error State
      setState({
        isLoading: false,
        message: error.message || "Login failed. Please try again.",
        type: "error"
      });
    }
  });

  // Input event listeners for real-time feedback
  const inputs = [usernameInput, passwordInput];
  inputs.forEach((input) => {
    input.addEventListener("input", () => {
      if (statusMsg.textContent) {
        statusMsg.textContent = "";
        statusMsg.className = "";
      }
    });
  });
});, html=<!DOCTYPE html>
