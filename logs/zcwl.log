* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-family);
    background-color: var(--bg-color);
    color: var(--text-color);
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition: background-color var(--transition-speed), color var(--transition-speed);
}

#clock-app {
    width: 100%;
    max-width: 480px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
}

/* 
  定向修改 ID: [DIV:clock-face] 
   Requirement: Background changed to Pink.
   Implementation: Using a vibrant Pink gradient for visual appeal while maintaining the glassmorphism structure.
*/
#clock-face {
    width: 100%;
    padding: 3rem 2rem;
    background: linear-gradient(135deg, #ec4899, #f472b6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 25px 50px -12px rgba(236, 72, 153, 0.4);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all var(--transition-speed) ease;
}

#time-display {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -2px;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 4px 12px rgba(0,0,0,0.1);
    /* Contrast adjustment for Pink background */
    color: #ffffff;
}

#date-display {
    font-size: 1.25rem;
    font-weight: 500;
    opacity: 0.95;
    letter-spacing: 1px;
    color: #fff;
}

#timezone-display {
    font-size: 0.875rem;
    opacity: 0.8;
    margin-top: 0.5rem;
    font-weight: 600;
    text-transform: uppercase;
    color: #fff;
}

#controls {
    display: flex;
    gap: 1rem;
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
}

button {
    background: transparent;
    color: var(--text-color);
    border: 1px solid var(--glass-border);
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(4px);
    flex: 1;
    min-width: 140px;
}

button:hover {
    background: var(--glass-border);
    transform: translateY(-2px);
    border-color: var(--accent-color);
    color: var(--accent-color);
}

button:active {
    transform: translateY(0);
}

@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.85; transform: scale(0.99); }
}

#time-display {
    animation: pulse 4s ease-in-out infinite;
}

@media (max-width: 480px) {
    #clock-app {
        padding: 1rem;
    }
    #time-display {
        font-size: 2.5rem;
    }
    #controls {
        flex-direction: column;
    }
    button {
        width: 100%;
    }
}, javascript=document.addEventListener("DOMContentLoaded", () => {
    // 1. State Management
    const state = {
        is24Hour: true,
        isDark: true,
        timerId: null
    };

    // 2. DOM Elements Selection with Safety Checks
    const els = {
        time: document.getElementById('time-display'),
        date: document.getElementById('date-display'),
        tz: document.getElementById('timezone-display'),
        toggleFormat: document.getElementById('toggle-format-btn'),
        toggleTheme: document.getElementById('toggle-theme-btn'),
        root: document.documentElement
    };

    // Defensive validation
    if (!els.time || !els.date || !els.tz || !els.toggleFormat || !els.toggleTheme) {
        console.error("Critical: Missing essential DOM elements.");
        return;
    }

    // 3. Core Logic: Time Formatting
    const formatTime = (date) => {
        try {
            let hours = date.getHours();
            let minutes = date.getMinutes();
            let seconds = date.getSeconds();
            let ampm = '';

            if (!state.is24Hour) {
                ampm = hours >= 12 ? ' PM' : ' AM';
                hours = hours % 12;
                hours = hours ? hours : 12; // hour '0' should be '12'
            }

            const pad = (num) => num.toString().padStart(2, '0');
            return `${pad(hours)}:${pad(minutes)}:${pad(seconds)}${ampm}`;
        } catch (e) {
            console.error("Error formatting time:", e);
            return "--:--:--";
        }
    };

    const formatDate = (date) => {
        try {
            const year = date.getFullYear();
            const month = (date.getMonth() + 1).toString().padStart(2, '0');
            const day = date.getDate().toString().padStart(2, '0');
            
            const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
            return `${year}-${month}-${day} ${days[date.getDay()]}`;
        } catch (e) {
            return "Date Error";
        }
    };

    // 4. Update Loop
    const updateClock = () => {
        const now = new Date();
        els.time.textContent = formatTime(now);
        els.date.textContent = formatDate(now);
        
        try {
            const offset = - (new Date().getTimezoneOffset());
            const sign = offset >= 0 ? '+' : '-';
            const absOffset = Math.abs(offset);
            const hours = Math.floor(absOffset / 60);
            const minutes = absOffset % 60;
            els.tz.textContent = `UTC${sign}${hours}:${minutes.toString().padStart(2, '0')}`;
        } catch (e) {
            els.tz.textContent = "Local";
        }
    };

    // 5. Event Handlers
    const handleFormatToggle = (e) => {
        e.preventDefault();
        state.is24Hour = !state.is24Hour;
        els.toggleFormat.textContent = state.is24Hour ? '切换 24H' : '切换 12H';
        updateClock();
    };

    const handleThemeToggle = (e) => {
        e.preventDefault();
        state.isDark = !state.isDark;
        
        if (state.isDark) {
            els.root.classList.remove('light-theme');
            els.toggleTheme.textContent = '切换亮色';
        } else {
            els.root.classList.add('light-theme');
            els.toggleTheme.textContent = '切换暗色';
        }
    };

    // 6. Initialization
    const init = () => {
        try {
            els.toggleFormat.textContent = '切换 12H';
            els.toggleTheme.textContent = '切换亮色';
            
            els.toggleFormat.addEventListener('click', handleFormatToggle);
            els.toggleTheme.addEventListener('click', handleThemeToggle);

            updateClock();
            state.timerId = setInterval(updateClock, 1000);
            
            console.log("Clock App Initialized Successfully.");
        } catch (error) {
            console.error("Initialization failed:", error);
        }
    };

    init();
});}, message=把北京改为蓝色渐变, selectId=[DIV:clock-app]}
