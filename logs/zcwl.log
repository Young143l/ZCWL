        filterButtons: {
            all: document.getElementById('filter-btn-all'),
            tech: document.getElementById('filter-btn-tech'),
            design: document.getElementById('filter-btn-design'),
            life: document.getElementById('filter-btn-life')
        },
        pagination: {
            prev: document.getElementById('pagination-btn-prev'),
            next: document.getElementById('pagination-btn-next'),
            info: document.getElementById('pagination-info')
        },
        articleDetailContent: document.getElementById('article-detail-content'),
        detailBackBtn: document.getElementById('detail-back-btn'),
        heroActionBtn: document.getElementById('hero-action-btn'),
        mobileMenuToggle: document.getElementById('mobile-menu-toggle'),
        mainNav: document.getElementById('main-nav'),
        navList: document.querySelector('.nav-list'),
        // createForm: document.getElementById('article-create-form'), // 保留注释
        // createSubmitBtn: document.getElementById('create-submit-btn'), // 保留注释
        // createCancelBtn: document.getElementById('create-cancel-btn'), // 保留注释
        currentYear: document.getElementById('current-year'),
        siteTitle: document.getElementById('site-title') // 新增定向修改 ID 引用
    };

    // 初始化检查
    if (!elements.appMain) {
        console.error('主应用容器未找到');
