*, *::before, *::after {
box-sizing: border-box;
margin: 0;
padding: 0;
}
body {
font-family: var(--md3-font-family);
background-color: var(--md3-sys-background);
color: var(--md3-sys-on-background);
line-height: 1.5;
-webkit-font-smoothing: antialiased;
}
#app-container {
min-height: 100vh;
display: flex;
flex-direction: column;
}
.md3-header {
position: sticky;
top: 0;
z-index: 100;
background-color: var(--md3-sys-surface);
border-bottom: 1px solid var(--md3-sys-outline-variant);
box-shadow: var(--md3-elevation-1);
}
.header-content {
max-width: 800px;
margin: 0 auto;
padding: 16px;
display: flex;
align-items: center;
justify-content: space-between;
flex-wrap: wrap;
gap: 12px;
}
#app-title {
font-size: 1.5rem;
font-weight: 500;
color: var(--md3-sys-primary);
}
.md3-nav {
display: flex;
gap: 8px;
}
.md3-nav-btn {
font-family: var(--md3-font-family);
font-size: 0.875rem;
font-weight: 500;
padding: 10px 24px;
border: none;
border-radius: 20px;
background: transparent;
color: var(--md3-sys-on-surface);
cursor: pointer;
transition: background-color var(--md3-motion-duration) var(--md3-motion-easing), 
color var(--md3-motion-duration) var(--md3-motion-easing);
}
.md3-nav-btn:hover {
background-color: var(--md3-sys-surface-variant);
}
.md3-nav-btn-active {
background-color: var(--md3-sys-secondary-container);
color: var(--md3-sys-on-secondary-container);
}
.md3-main {
flex: 1;
max-width: 800px;
width: 100%;
margin: 0 auto;
padding: 24px 16px;
}
.md3-view {
display: none;
animation: fadeIn var(--md3-motion-duration) var(--md3-motion-easing);
}
.md3-view-active {
display: block;
}
@keyframes fadeIn {
from { opacity: 0; transform: translateY(8px); }
to { opacity: 1; transform: translateY(0); }
}
.md3-post-list {
display: flex;
flex-direction: column;
gap: 16px;
}
.md3-post-card {
background-color: var(--md3-sys-surface);
border: 1px solid var(--md3-sys-outline-variant);
border-radius: 12px;
padding: 20px;
cursor: pointer;
transition: box-shadow var(--md3-motion-duration) var(--md3-motion-easing), 
border-color var(--md3-motion-duration) var(--md3-motion-easing);
}
.md3-post-card:hover {
box-shadow: var(--md3-elevation-2);
border-color: var(--md3-sys-primary);
}
.md3-post-card-title {
font-size: 1.25rem;
font-weight: 500;
color: var(--md3-sys-on-surface);
margin-bottom: 8px;
}
.md3-post-card-excerpt {
font-size: 0.875rem;
color: var(--md3-sys-on-surface-variant);
margin-bottom: 12px;
}
.md3-post-card-meta {
font-size: 0.75rem;
color: var(--md3-sys-outline);
display: flex;
gap: 16px;
}
.md3-post-detail {
background-color: var(--md3-sys-surface);
border-radius: 12px;
padding: 24px;
box-shadow: var(--md3-elevation-1);
}
.md3-post-detail-title {
font-size: 1.75rem;
font-weight: 500;
color: var(--md3-sys-on-surface);
margin-bottom: 16px;
}
.md3-post-detail-meta {
font-size: 0.875rem;
color: var(--md3-sys-outline);
margin-bottom: 24px;
padding-bottom: 16px;
border-bottom: 1px solid var(--md3-sys-outline-variant);
}
.md3-post-detail-content {
font-size: 1rem;
color: var(--md3-sys-on-surface);
line-height: 1.7;
white-space: pre-wrap;
}
